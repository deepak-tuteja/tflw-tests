# testFlow-tests v2 config: a single Dockerized NestJS+Postgres service (apiV2), everything
# under one host port with a real `/v1` prefix baked into the env's base URL. The old
# `api`/`auth` named-service split is gone — both auth transports now live in the same app.
# `admin` showcases bearer auth; `shopper` showcases cookie auth via tflw's automatic cookie jar
# (SPEC §3.3, P#33, shipped in tflw 0.1.0's M5 gap-fix pass) — no manual `capture header
# "set-cookie"`/`header "Cookie" is …` needed anymore. `session-login-full`'s dual Set-Cookie
# (`session` + `session_refresh`) is still exercised by a dedicated non-session test in
# sessions.tflw (it asserts on the raw header's own attributes, unrelated to jar consumption) —
# see TFLW-GAPS.md #1 for the gap this fixed and tests/api/identity/cookie-jar.tflw for the executable proof.

# `defaults: timeout wait 5s` (PLAN M1.5): keeps tests/.demo-fail/wait-timeout.tflw's intentional
# timeout fast (~5s) instead of the runtime's 30s default.
defaults
  timeout wait 5s

env local default
  api "http://localhost:4001/v1"
  # M130c (D21 layer 2). The dogfood suite may scan itself — this is the one host in the world
  # this repo starts, seeds and destroys, and `tests/api/identity/authz-generated.tflw` cannot ask
  # tflw's authorization matcher anything without it (`TF060`).
  #
  # **This reverses D291's split deliberately, and the split was right when it was made.** M128c put
  # `authorized target` only in `tflw-acceptance/security/` so that the dogfood suite demonstrated
  # the *refusal* and the corpus demonstrated the *permission*. That pairing is preserved: the
  # `.checkonly` fixtures still fire `TF060` (they run with no config of their own), so the refusal
  # is still dogfooded — what changes is that the suite which owns this stack may now also scan it.
  authorized target "http://localhost:4001" reason "self-hosted dogfood target in this repo, started and destroyed by ./cli.mjs"
  # Unversioned root (M3): Swagger/OpenAPI mounts outside the `/v1` prefix, and this base also
  # proves the prefix is genuinely enforced (a versioned-only route 404s when hit unversioned).
  api root "http://localhost:4001"
  # M7 (tflw PLAN.md M7 acceptance corpus, PLAN_WEBV2_TARGETS.md): the browser dogfood target,
  # the Vite+React SPA storefront served by webV2's nginx (docker-compose.yml's `webv2` service).
  web "http://localhost:8090"
  # PLAN_ENTERPRISE_REGRESSION.md E4 — inventory-service's own port, no env conflict (unlike
  # webv2-admin's `web` base): §3.2's named-service form lets `env local` carry more than one
  # named `api` target at once, so tests/api/inventoryOps/ and tests/mixed/inventoryOps/ can hit
  # it directly (`api inventory GET /warehouses`) in the same run as everything else.
  api inventory "http://localhost:4002/v1"
  # tflw M131a (D343). **`TF060` widened from the default `api` base to every scannable origin**,
  # and `inventory` is the reason that widening was not academic: it is a *different origin* (4002),
  # and until M131a a security or authorization assertion could be pointed at it with no declaration
  # at all — no affirmation, no reason, nothing in the report saying what was claimed. The
  # declaration above authorizes 4001 and, by origin, nothing else.
  #
  # This line is this repo's own answer to the question the widening asks every multi-service
  # project: is the widened gate livable? One line per origin the suite can actually reach, which is
  # the same bargain the first declaration already made.
  authorized target "http://localhost:4002" reason "self-hosted inventory-service in this repo's own compose stack, started and destroyed by ./cli.mjs"
  # M23 (enterprise arc cluster 2 consumption, testFlow PLAN.md decision 101a): every test in this
  # suite only ever talks to this machine, so allowlisting it here has zero blast radius on the
  # other ~30 files — it's the positive-path proof that a real allowlist doesn't false-positive-
  # block normal traffic. The negative case (a host genuinely blocked) needs a *different*
  # allowlist — see `env allowHostsBlocked` below, its own dedicated env for the same blast-radius
  # reason `mtlsSidecar` is dedicated.
  #
  # `127.0.0.1` joins `localhost` as of tflw M85: an allowlist matches on hostname, not address, so
  # the two spellings of this one machine are two different entries. `/safety-demo/offsite-redirect`
  # redirects to the `127.0.0.1` spelling, and under *this* env that hop is meant to go through —
  # it is what keeps `allow-hosts-blocked.tflw` an ordinary passing request here and a refusal only
  # under the env that means to refuse it (see `scripts/verify-demofail.mjs`).
  allow hosts "localhost", "127.0.0.1"

# M7: the SSR admin console (`webv2-admin` service, full-page-nav dogfood target — a different
# flake class than the SPA storefront's async re-renders). Its own dedicated `env`, same
# blast-radius reasoning as `mtlsSidecar`/`safetyRedaction` below: `web` is a single base URL per
# env (no named-service form the way `api` has, §3.2), so the two UI targets can't share one env.
env webv2Admin
  api "http://localhost:4001/v1"
  web "http://localhost:8091"

# testFlow M128a (PLAN_M128_PENTEST_TIER1.md D293) — the pentest arc's target: the *plain* https
# listener of the same nginx sidecar `mtlsSidecar` uses (8443, no client cert required). Tier 1's
# rule pack is largely a set of claims about a TLS response — `Strict-Transport-Security` over
# plaintext is meaningless and a `Secure` cookie is unsettable there — so a run under `env local`
# would report most of the pack not-applicable rather than passing it.
#
# Nothing had to be built for this: M22 stood the listener up two arcs ago and only ever pointed
# envs at its 8444 sibling. Its own dedicated env for the usual blast-radius reason, and here a
# sharper one — `insecure true` disables server-certificate verification process-wide for the run
# (tflw SPEC §3.5), which is the right trade against a cert regenerated per container start and
# wrong to inherit anywhere else.
#
# The allowlist agrees with the base URL, which tflw M85's `TF036` requires; it is also what D291
# will build on, since Tier 1 refuses to scan a host the config has not declared.
env secureLocal
  api "https://localhost:8443/v1"
  insecure true
  allow hosts "localhost"

# M22 (enterprise arc cluster 1): the nginx TLS sidecar's mTLS-requiring listener (8444, proxying
# to the same api:4001 backend — see ../nginx/). Deliberately its own `env`, not folded into
# `local` above: setting `cert`/`key` routes *every* request in the active env through tflw's
# undici mTLS dispatcher instead of the plain global fetch (testFlow PLAN.md decision 99b) — fine
# for this one dedicated file, but pointless blast radius against the other ~30 files that only
# ever need the plain :4001 backend. Run with `tflw run --env mtlsSidecar` (or `npm run
# test:mtls`), not part of the default `npm test` run. `insecure true` because the sidecar's
# server cert is signed by a throwaway CA generated fresh per container start (never a stable
# trust root worth pointing NODE_EXTRA_CA_CERTS at) — the client certificate below is the actual
# thing under test, not server-cert trust.
env mtlsSidecar
  api "https://localhost:8444/v1"
  insecure true
  # Relative to *this file's* own directory (the project root), per tflw SPEC §3.6 — `cert`/`key`
  # are config keys, so they resolve against the config, not against whichever `.tflw` file happens
  # to be making the request.
  #
  # This used to read `"../../../nginx/certs/client.pem"`, with a comment asserting the opposite
  # rule: "relative to the *consuming* .tflw file's own directory ... same file-relative convention
  # as `import`/`use`/`with each from`". That was not a convention, it was tflw bug `M104-01`, and
  # this config is where it was found — `../../../` from the project root points *outside the repo*,
  # and the line only ever worked because `execApi` resolved it against `dirname(<test file>)`.
  # The old comment even named the constraint holding it up: exactly one file may use this env, and
  # only from exactly three levels deep. A second consumer at any other depth would have broken it.
  # Fixed in tflw M104 (D183/D185); this is the path someone would have written first had the rule
  # been right all along.
  cert "nginx/certs/client.pem"
  key "nginx/certs/client.key"

# PLAN_CI.md decision 6: the negative case for mTLS — same mTLS-requiring listener as
# `mtlsSidecar` above, deliberately with no `cert`/`key`, so every request through this env hits
# the real `ssl_verify_client on` rejection. Its own dedicated env for the same blast-radius
# reason `mtlsSidecar` itself is separate from `local` — only enabled by tflw's own decision 18
# (`expect request fails`/`connects`, testFlow M14), which is why this env didn't exist before now.
env mtlsSidecarNoCert
  api "https://localhost:8444/v1"
  insecure true

# M23 (enterprise arc cluster 2 consumption, testFlow PLAN.md decision 101d): declarative field
# redaction against the new PII-rich `/profile/export` fixture (PLAN_ENTERPRISE.md decision 11,
# apiV2/src/profile-export/). Its own dedicated env for the same reason `mtlsSidecar` is dedicated
# — `redact` has no CLI override (unlike `evidence`, which tests/api/identity/safety-redaction.tflw exercises
# via `--evidence` at run time instead, no env needed), so it would otherwise mask matching fields
# in every other file's report too if declared under `local`. `body.email` masks the top-level
# field the endpoint returns; `body.address.*` masks every key *under* `address` (street/city/
# postalCode) — a trailing wildcard, complementing tflw's own `body.*.address` (leading-wildcard,
# over an array) unit coverage in packages/runtime/test/field-redaction.test.ts. `body.phone`
# added M25: scripts/verify-redaction.mjs proves no real PII reaches report.html/results.json,
# and the endpoint's phone field is exactly as much PII as email/address — M23 had simply never
# asserted on it reaching the report unmasked before this proof existed.
env safetyRedaction
  api "http://localhost:4001/v1"
  redact body.email, body.phone, body.address.*

# M23: the negative case for `allow hosts` — a real host genuinely gets blocked, not just "never
# happens to matter because everything already points at localhost" (env local's own allowlist
# above).
#
# Reshaped for tflw M85 (review cluster C1): this env used to declare an `api` base that its own
# allowlist excluded, which is now a `tflw check` error (`TF036`) — a config written that way never
# reaches the runtime, so the fixture would have proved the checker rather than the guardrail it
# exists for. The allowlist and the base URL therefore agree here, and the blocked host arrives the
# way it does in real life: the *server* redirects the run to it (`/safety-demo/offsite-redirect`
# → `http://127.0.0.1:<port>/v1/health`, a real reachable address that is a different *host* to
# this list). See `tests/.demo-fail/allow-hosts-blocked.tflw`.
env allowHostsBlocked
  api "http://localhost:4001/v1"
  allow hosts "localhost"

# M29 (plan_v2.md Part R, coverage audit): `expect request connects`/`fails` (SPEC §6.2.2) had zero
# real usage anywhere in this suite. A wrong-CA-signed mTLS client cert was tried first and
# rejected empirically — confirmed via curl that nginx's `ssl_verify_client on` (http module)
# completes the TLS handshake regardless and returns a plain HTTP 400 either way (no cert or a
# cert from an untrusted CA), the same non-connection-failure shape `mtls-rejection.tflw` already
# proves — it can't exercise this matcher. A closed local port gives a genuine, deterministic
# connection-layer failure (`ECONNREFUSED`) instead. Own dedicated env (same blast-radius reason
# as `mtlsSidecar`/`allowHostsBlocked`): nothing else in this suite should ever point here.
env unreachableHost
  api "http://localhost:9"

# M51 (PLAN_LOG_CONSUME.md): proves tflw's `log destination`/`log level` config keys (SPEC.md
# §3.8) against a real run — its own dedicated env, same blast-radius reasoning as
# `mtlsSidecar`/`safetyRedaction`/`allowHostsBlocked`: the top-level `defaults` block above
# deliberately does *not* declare either key, because a project-wide `log level` tighter than the
# built-in "debug" (show everything) default would silently suppress the console visibility of the
# one-line-per-file `log` sweep this milestone also added across the other ~44 files. `log
# destination console`/`log level warn` here are this env's own values, distinct from the
# built-in default (`both`/`debug`) — tests/api/mechanics/logging.tflw and scripts/verify-logging.mjs prove a
# bare `log` call resolves against these, an explicit per-statement `to …` clause always wins over
# them, and `--log-output`/`--log-level` override them for one run without ever touching an
# explicit `to …` clause.
env logConfig
  api "http://localhost:4001/v1"
  log destination console
  log level warn

# M130c: `privileged` — excluded from every Tier 2 probe set, and announced on each assertion rather
# than quietly dropped. An administrator legitimately reads other people's orders (`findOneScoped`
# admits owner, admin, and org owner/admin), so probing as one reports a fact about the role model
# rather than a broken boundary.
session admin privileged
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"

session shopper
  api POST /auth/session-login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  # cookies auto-tracked from Set-Cookie by the jar — no capture/header needed

# testFlow M130a (PLAN_M130_PENTEST_TIER2.md D317) — the pentest arc Tier 2's second ordinary
# identity: a fellow non-admin user, seeded as user B (`apiV2/src/seed/seed.ts`), whose whole job is
# to be *someone else*. Tier 2 re-issues a request under every declared session but the owner's, so
# a suite that declares one shopper has nobody to probe with; `peer` is who it probes as.
#
# **Bearer, not cookie, and that is a correction to D317 rather than a preference.** The plan said
# "cookie transport, mirroring `shopper`" — but `AnyAuthGuard` requires an `X-CSRF-Token` matching
# the session token's own claim on every POST/PUT/PATCH/DELETE, and a session block does not expose
# that token to the test (`tests/api/identity/sessions.tflw` captures `body.csrfToken` by hand for
# exactly this reason). A cookie-borne `peer` would therefore be refused with `403 missing or
# invalid CSRF token` on every mutating probe — *before* the authorization check the tier exists to
# test — and D311's `DELETE` plant would read as correctly-denied when it was never consulted. What
# mattered about "mirroring shopper" is that `peer` is an ordinary user rather than an
# administrator, and that is a fact about the seeded role, not about the transport. `authz.tflw`,
# this file's control, already logs user B in over `/auth/login` for the same reason.
session peer
  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"

# M22 (enterprise arc cluster 1): the `oauth2` session sugar (testFlow PLAN.md decision 99c),
# against apiV2's new `/oauth/token` client-credentials endpoint (PLAN_ENTERPRISE.md decision 11).
# Two clients, mirroring the two configured server-side (apiV2/src/oauth/oauth.service.ts):
# `oauthLong` (normal TTL, plain reuse) and `oauthShort` (~5s TTL, proactively re-fetched ahead of
# expiry — tests/api/identity/session-refresh-and-oauth2.tflw exercises the difference). The token endpoint is
# hardcoded to the real api's own base port, same convention as `env local`'s own hardcoded `api`
# value above — it's independent of whichever env is active, since a client-credentials grant
# isn't itself a per-env concept.
# **M130c, and this pair is the whole of `M130-06`.** These two look like machine clients and read
# as ordinary non-admin identities; they are not. `apiV2/src/oauth/oauth.service.ts` signs the
# client-credentials grant **for the seeded admin user** — "the admin service account" — so the token
# each mints carries `role: ADMIN` and `findOneScoped` admits it for exactly the reason it admits
# `admin`. Nothing in the declaration below says so; the fact lives in the server's grant code.
#
# Measured before this line existed: with only `admin` marked, `authz-generated.tflw` reported **two
# critical `sec/authz-object-leak` findings**, one per OAuth session, each naming a real id really
# served to a real non-owner, each with a runnable repro. Every piece of evidence was accurate and
# the conclusion was wrong. **`privileged` is a claim about an identity's authority, and you cannot
# read authority off a session declaration** — you find it by running the tier and asking, per
# principal, whether the access it demonstrated is a role fact or a bug. Both of these are role facts.
#
# `privileged` comes *after* `oauth2` (`TF010` says so, and says why: the modifier is read last so
# `oauth2` stays next to the indented block it introduces).
session oauthLong oauth2 privileged
  token url "http://localhost:4001/v1/oauth/token"
  client id env(OAUTH_CLIENT_ID)
  client secret env(OAUTH_CLIENT_SECRET)
  scope "orders.read orders.write"

session oauthShort oauth2 privileged
  token url "http://localhost:4001/v1/oauth/token"
  client id env(OAUTH_SHORT_CLIENT_ID)
  client secret env(OAUTH_SHORT_CLIENT_SECRET)

# tflw 0.1.0 M58 (D127, PLAN_DISCOVERY_EXCLUDE.md): tflw-acceptance/ is a second, independent
# suite (own per-subdirectory tflw.config, own sessions/envs) moved in by the 2026-08-02 reorg
# (PLAN_UNIFIED_RUN_DOGFOOD_REORG.md Phase 2). Without this, every bare `npm test`/`npm run
# regression` invocation's no-file-args discovery also swept its files against *this* config's
# sessions, which don't exist there — TF028: unknown session. Only affects bare discovery; running
# a file inside tflw-acceptance/ explicitly, or from its own directory, is unaffected either way.
exclude "tflw-acceptance"

# `M156f` (`D774`, `TF077`). Until tflw grew its check-time half, this line declared **10** names
# while `tests/**` read **24** — and the sixteen of those it did not name were exactly the ones the run-start
# gate could not protect. `require env` is a precondition on the *environment* (`D776`), so an
# undeclared `env(NAME)` is not merely undocumented: it is outside the gate, and a missing value
# reaches `eval.ts` mid-suite on whichever iteration touches it first. That is the failure mode the
# manifest sentence promised would not happen, reproduced in the suite that exists to dogfood it.
#
# Measured on the box the day the codes merged, against the *unfixed* tree: **60** `TF077`, 50 under
# bare discovery (`tests/api/admin/tickets.tflw`, `tests/api/orgOps/cross-org-visibility.tflw`,
# `tests/api/orgOps/organizations-crud.tflw`) and 10 more in `tests/.env-specific/`. All 16 names
# were already in `.env` **and** `.env.example`, which is why nothing had ever gone red: the suite
# was correct by accident of a file no gate reads, not by declaration.
#
# `tflw-acceptance/`'s eight corpora came back clean — every one of them declares what it reads. The
# defect was this file's alone, and split across three lines because `require env`'s list ends at the
# line (`SPEC:1957`) and one 26-name line is unreviewable.
require env ADMIN_EMAIL, ADMIN_PW, USER_A_EMAIL, USER_A_PW, USER_B_EMAIL, USER_B_PW, OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET, OAUTH_SHORT_CLIENT_ID, OAUTH_SHORT_CLIENT_SECRET
require env AGENT_A_EMAIL, AGENT_A_PW, AGENT_B_EMAIL, AGENT_B_PW
require env ORG_A_OWNER_EMAIL, ORG_A_OWNER_PW, ORG_A_ADMIN_EMAIL, ORG_A_ADMIN_PW, ORG_A_MEMBER_EMAIL, ORG_A_MEMBER_PW
require env ORG_B_OWNER_EMAIL, ORG_B_OWNER_PW, ORG_B_ADMIN_EMAIL, ORG_B_ADMIN_PW, ORG_B_MEMBER_EMAIL, ORG_B_MEMBER_PW
