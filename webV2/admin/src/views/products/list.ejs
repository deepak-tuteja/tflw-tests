<%- include('../partials/head', { title: 'Products' }) %>
<%- include('../partials/nav') %>
<h1>Products</h1>
<form method="get" action="/products">
  <label for="q">Search</label>
  <input id="q" name="q" value="<%= q %>" />
  <label for="categoryId">Category</label>
  <select id="categoryId" name="categoryId">
    <option value="">All categories</option>
    <% categories.forEach(function(c) { %>
      <option value="<%= c.id %>" <%= c.id === categoryId ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>
  <button type="submit">Filter</button>
</form>

<table>
  <thead>
    <tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th></tr>
  </thead>
  <tbody>
    <% products.forEach(function(p) { %>
      <% const cat = categories.find(function(c) { return c.id === p.categoryId; }); %>
      <tr>
        <td><a href="/products/<%= p.id %>"><%= p.name %></a></td>
        <td><%= cat ? cat.name : p.categoryId %></td>
        <td><%= p.price %></td>
        <td><%= p.stock %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<p>
  Page <%= page %> of <%= Math.max(1, Math.ceil(total / pageSize)) %> (<%= total %> products)
  <% if (page > 1) { %> · <a href="/products?<%= new URLSearchParams({ page: page - 1, categoryId, q }).toString() %>">Previous</a><% } %>
  <% if (page * pageSize < total) { %> · <a href="/products?<%= new URLSearchParams({ page: page + 1, categoryId, q }).toString() %>">Next</a><% } %>
</p>
<%- include('../partials/foot') %>
