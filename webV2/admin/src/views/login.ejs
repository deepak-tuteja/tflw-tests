<%- include('partials/head', { title: 'Log in' }) %>
<h1>testFlow-tests admin console</h1>
<p>Log in with a seeded admin or agent account (e.g. <code>admin@example.com</code> / <code>admin-pw-123</code>, or <code>carol@example.com</code> / <code>carol-pw-123</code>).</p>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/login">
  <label for="email">Email</label>
  <input id="email" name="email" type="email" required autofocus />
  <label for="password">Password</label>
  <input id="password" name="password" type="password" required />
  <p><button type="submit">Log in</button></p>
</form>
<p class="fixture-note">
  <!-- V17's negative has to be reachable from the walk that grades it, and that walk is
       unauthenticated — so the link lives here, on the one page a spider sees without a session.
       See VULNS.md V16/V17. -->
  <a href="/hardened">Hardened fixture page</a>
</p>
<%- include('partials/foot') %>
