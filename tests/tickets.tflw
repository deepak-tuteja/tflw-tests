# tickets.tflw — PLAN_TICKETING.md T3: `.tflw` coverage of the ticketing/support-domain
# initiative (T1 sync core + T2's async SLA sweep). Novel surface beyond every prior file: a third
# role (AGENT) scoped to specific resource instances rather than the blanket admin/non-admin binary
# every other authz check in this app uses; a role-filtered response body (isInternal comments,
# same endpoint returning different data by caller — every prior authz check in this suite is
# all-or-nothing 403/404); this app's first cross-endpoint race (owner-cancels vs. agent-resolves);
# and the suite's first collection-level `wait until` (decision 8/11's `?slaBreached=true` combined
# with `expect body has count N`, distinct from every prior `wait until` which always targets a
# single resource's own eventual state).
#
# Inline per-test logins throughout (not `as admin`/a cached session), same reasoning
# return-requests.tflw and jobs.tflw already settled on: this file sorts late enough in the suite
# that a cached admin session's 5s-TTL bearer token can be stale by the time these tests run.
#
# Agent-identity discipline: AGENT_B (dave) is reserved exclusively for the collection-level test
# below — every other test here only ever uses AGENT_A (carol) as the agent who successfully
# claims/acts. That keeps `?assignedTo={daveId}` an exact, order-independent count no matter what
# order these tests execute in, without needing a query filter this DTO doesn't expose (there's no
# subject/description search).

@ticketing @adminOps
test "the full ticket lifecycle: owner submits, an agent claims/starts/resolves, the owner closes"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as carolToken

  api POST /tickets body { subject: unique("Printer jam"), description: "the office printer is jammed again" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  expect body.status equals "open"
  expect body.assignedTo equals null
  capture body.id as ticketId

  api GET /tickets/{ticketId}/history
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 200
  expect body has count 1
  expect body[0].eventType equals "created"

  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  expect body.status equals "open"

  api POST /tickets/{ticketId}/start
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  expect body.status equals "in_progress"

  api POST /tickets/{ticketId}/resolve
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  expect body.status equals "resolved"

  # Owner-only (decision 3) — mirrors cancel's own restriction, deliberately no ADMIN/AGENT
  # override. The owner is the one confirming the resolution.
  api POST /tickets/{ticketId}/close
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 200
  expect body.status equals "closed"

  # ADMIN's blanket authority (decision 2) — sees the ticket regardless of who submitted/claimed it.
  api GET /tickets/{ticketId}
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect body.status equals "closed"

  api GET /tickets/{ticketId}/history
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect body has count 5
  expect body[0].eventType equals "created"
  expect body[1].eventType equals "claimed"
  expect body[2].eventType equals "started"
  expect body[3].eventType equals "resolved"
  expect body[4].eventType equals "closed"

@ticketing @adminOps
test "claiming an already-claimed ticket is a conflict — first agent wins"
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as carolToken

  api POST /auth/login body { email: env(AGENT_B_EMAIL), password: env(AGENT_B_PW) }
  expect status equals 200
  capture body.accessToken as daveToken

  api POST /tickets body { subject: unique("Password reset"), description: "can't log in" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketId

  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  expect body.assignedTo not equals null

  # Dave's claim never succeeds anywhere in this file — see the header note on agent-identity
  # discipline — so this 409 leaves the ticket's assignedTo untouched at carol's claim.
  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 409

  # Re-claiming your own already-claimed ticket is also a conflict, just a different message
  # (TicketsService.claim distinguishes the two cases) — same status code either way.
  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 409

@ticketing @adminOps
test "resolving a ticket blocks a concurrent cancel — the suite's first cross-endpoint race"
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as carolToken

  api POST /tickets body { subject: unique("Billing question"), description: "double-charged?" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketId

  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200

  api POST /tickets/{ticketId}/start
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200

  # The agent's resolve reaches the ticket first — same "whichever check-then-write lands first
  # in the event loop wins" precedent as return-requests.tflw's duplicate-decision 409.
  api POST /tickets/{ticketId}/resolve
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  expect body.status equals "resolved"

  # The owner's cancel arrives after — decision 3 only allows cancel from OPEN/IN_PROGRESS, so this
  # is a 409 against the now-RESOLVED ticket, exactly as plainly as resolve's own precondition would
  # reject a concurrent cancel the other way around.
  api POST /tickets/{ticketId}/cancel
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 409

@ticketing @adminOps
test "an isInternal comment is visible to agents and admins but hidden from the ticket's owner"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as carolToken

  api POST /tickets body { subject: unique("Refund status"), description: "when will I hear back?" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketId

  api POST /tickets/{ticketId}/comments body { text: "any update?" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  expect body.isInternal equals false

  # The ticket owner may never post an internal note — decision 5 is ADMIN/AGENT-only for that flag.
  api POST /tickets/{ticketId}/comments body { text: "sneaking this in", isInternal: true }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 403

  api POST /tickets/{ticketId}/comments body { text: "escalating to billing team", isInternal: true }
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 201
  expect body.isInternal equals true

  api POST /tickets/{ticketId}/comments body { text: "approved for expedited refund", isInternal: true }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201

  # The owner's own GET only ever sees the non-internal comment she posted.
  api GET /tickets/{ticketId}/comments
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 200
  expect body has count 1
  expect all body.isInternal equals false

  # The assigned agent and admin both see all three.
  api GET /tickets/{ticketId}/comments
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  expect body has count 3

  api GET /tickets/{ticketId}/comments
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect body has count 3

@ticketing @adminOps
test "an SLA deadline breaches in the background, independent of the ticket's own workflow status"
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /tickets body { subject: unique("Slow breach test"), description: "never touched by any agent" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  expect body.slaBreached equals false
  capture body.id as ticketId

  # Purely informational (decision 4) — the ticket stays "open" the whole time, only slaBreached
  # flips, proving "workflow stage" and "is it late" are independent axes.
  wait until api GET /tickets/{ticketId}
    header "Authorization" is "Bearer {aliceToken}"
    expect body.slaBreached equals true

  api GET /tickets/{ticketId}
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 200
  expect body.status equals "open"

  api GET /tickets/{ticketId}/history
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 200
  expect body has count 2
  expect body[1].eventType equals "sla_breached"

@ticketing @adminOps
test "the ticket collection composes wait until with a count assertion across multiple breached tickets"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_B_EMAIL), password: env(AGENT_B_PW) }
  expect status equals 200
  capture body.accessToken as daveToken

  api GET /auth/profile
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 200
  capture body.id as daveId

  api POST /tickets body { subject: unique("Dave's ticket A"), description: "first of two" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketAId

  api POST /tickets body { subject: unique("Dave's ticket B"), description: "second of two" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketBId

  api PATCH /tickets/{ticketAId}/assign body { assigneeId: "{daveId}" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200

  api PATCH /tickets/{ticketBId}/assign body { assigneeId: "{daveId}" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200

  # decision 8/11's novel combination — a collection endpoint (not a single resource) as the target
  # of `wait until`, with a `has count` assertion as the eventual condition rather than an
  # equals/contains on one field. Scoped to dave alone (see the file header) so the count is exact
  # regardless of what any other test in this file has done.
  wait until api GET /tickets?assignedTo={daveId}&slaBreached=true
    header "Authorization" is "Bearer {adminToken}"
    expect body has count 2

@ticketing @adminOps @authz
test "only an admin may assign a ticket to an agent"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as carolToken

  api GET /auth/profile
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200
  capture body.id as carolId

  api POST /tickets body { subject: unique("Needs assignment"), description: "who's on this?" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketId

  # Neither the ticket's own owner nor an agent may assign — @Roles(ADMIN) on the route itself.
  api PATCH /tickets/{ticketId}/assign body { assigneeId: "{carolId}" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 403

  api PATCH /tickets/{ticketId}/assign body { assigneeId: "{carolId}" }
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 403

  api PATCH /tickets/{ticketId}/assign body { assigneeId: "{carolId}" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect body.assignedTo equals "{carolId}"

  # The assignee must actually be an AGENT (decision 6) — assigning to a plain USER is a 422, not a
  # 403/404, since the request is well-formed and the id resolves, just to the wrong kind of user.
  api GET /auth/profile
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 200
  capture body.id as aliceId

  api PATCH /tickets/{ticketId}/assign body { assigneeId: "{aliceId}" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 422

  api PATCH /tickets/{ticketId}/assign body { assigneeId: "00000000-0000-0000-0000-000000000000" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 404

@ticketing @adminOps @authz
test "an agent cannot see or act on a ticket assigned to a different agent"
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as carolToken

  api POST /auth/login body { email: env(AGENT_B_EMAIL), password: env(AGENT_B_PW) }
  expect status equals 200
  capture body.accessToken as daveToken

  api POST /tickets body { subject: unique("Carol's alone"), description: "assigned to carol only" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketId

  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {carolToken}"
  expect status equals 200

  # Role-scoped 404 (decision 2) — the ticket simply doesn't exist as far as dave's view goes, same
  # framing as every other visibility check in this app.
  api GET /tickets/{ticketId}
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 404

  api GET /tickets/{ticketId}/comments
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 404

  api GET /tickets/{ticketId}/history
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 404

  api POST /tickets/{ticketId}/start
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 404

  # claim deliberately bypasses the visibility check (T1's own exception) — dave gets the same 409
  # an already-claimed ticket gives anyone, not a 404.
  api POST /tickets/{ticketId}/claim
    header "Authorization" is "Bearer {daveToken}"
  expect status equals 409

@ticketing @adminOps @authz
test "a non-owner cannot close or cancel someone else's ticket — not even an admin"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as aliceToken

  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as bobToken

  api POST /tickets body { subject: unique("Alice's private ticket"), description: "not bob's business" }
    header "Authorization" is "Bearer {aliceToken}"
  expect status equals 201
  capture body.id as ticketId

  # Bob has no privileged role and isn't the owner — the ticket is invisible to him outright.
  api GET /tickets/{ticketId}
    header "Authorization" is "Bearer {bobToken}"
  expect status equals 404

  api POST /tickets/{ticketId}/close
    header "Authorization" is "Bearer {bobToken}"
  expect status equals 404

  api POST /tickets/{ticketId}/cancel
    header "Authorization" is "Bearer {bobToken}"
  expect status equals 404

  # An admin, by contrast, sees the ticket fine (decision 2's blanket authority) — but close/cancel
  # are deliberately owner-only with no admin override (decision 3), so the admin gets a 403 rather
  # than the 404 a stranger like bob gets: the ticket is visible, the action just isn't theirs to take.
  api GET /tickets/{ticketId}
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200

  api POST /tickets/{ticketId}/cancel
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 403
