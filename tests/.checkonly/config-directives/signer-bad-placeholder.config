# signer-bad-placeholder.config — `C127`'s control (tflw `M246`, `TF087`): `signer.config` with
# `{timestamp}` misspelled `{timestmp}` in `signs`. A signer fills only its own placeholders, so the
# misspelling would be signed as literal text; the checker refuses it at the `signs` line instead.

signer stripe hmac sha256 hex secret "check-only"
  signs "{timestmp}.{body}"
  header "Stripe-Signature" is "t={timestamp},v1={signature}"

env local default
  api "http://localhost:9/v1"
