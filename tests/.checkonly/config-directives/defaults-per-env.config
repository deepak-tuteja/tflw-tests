# defaults-per-env.config — `M154g` step 4a: `C93`'s negative control.
#
# `defaults-shared.config` with the `allow hosts` line moved into `env one`. Under `--env one` the
# `TF036` is unchanged; under `--env two` it is gone. Without this file the positive half is
# equally consistent with an allowlist that is global no matter where it is written, which would
# make `defaults` a word the parser accepts rather than a scope it honours.

env one default
  api "http://localhost:4001/v1"
  allow hosts "example.test"

env two
  api "http://127.0.0.1:4001/v1"
