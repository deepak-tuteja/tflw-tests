# defaults-duplicated.config — `M154g` step 4a: `C93`'s second clause, which the manifest states in
# the same sentence as the first — *"settings shared by every environment; **at most one per
# config**"*.
#
# Two `defaults` blocks, and `TF022` refuses the file. The env's base URL is inside the allowlist
# on purpose: `TF036` must not fire here, so the code this leg asserts is the only one in the
# output and the assertion cannot pass on the strength of a different complaint.

defaults
  allow hosts "example.test"

defaults
  timeout wait 5s

env one default
  api "http://example.test/v1"
