# exclude-on.config — `M154g` step 4a: `C96` (`config:directive:exclude`).
#
# Its control is `exclude-off.config`, which is this file with the last line deleted. Discovery
# reports one file here and two there, over an unchanged corpus of `kept.tflw` and
# `excluded/skipped.tflw`.

env local default
  api "http://localhost:4001/v1"

exclude "excluded"
