# signer.config — tflw `M246` (`D1345`/`D1346`): `C127` (`config:directive:signer`).
#
# A Stripe-shaped `hmac` signer, declared once, with its secret as a literal because this row is
# check-tier and never sends anything. Its control is `signer-bad-placeholder.config`, this file with
# one placeholder misspelled, which is refused at that line.

signer stripe hmac sha256 hex secret "check-only"
  signs "{timestamp}.{body}"
  header "Stripe-Signature" is "t={timestamp},v1={signature}"

env local default
  api "http://localhost:9/v1"
