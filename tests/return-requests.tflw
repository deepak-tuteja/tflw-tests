# return-requests.tflw — PLAN_RETURNS.md R3: `.tflw` coverage of the order-return-request
# initiative (R1 sync submit/approve/reject + R2's async refund job). Two straight-line chains
# sharing a common setup (register a product, order it, fulfill it, submit a return request) —
# not runtime branching (decision 8): each test's outcome (approve or reject) is fixed by its
# author, so this doesn't exercise tflw's no-conditionals fence. The novel surface here is genuine
# multi-identity coordination (owner submits, admin decides) and an admin's decision determining
# which of two real downstream paths (refund job vs. nothing) gets exercised.
#
# Inline per-test logins throughout (not `as admin`/a cached session), same reasoning jobs.tflw and
# user-lifecycle.tflw already settled on: this file sorts late enough in the suite that a cached
# admin session's 5s-TTL bearer token can be stale by the time these tests run.

before
  api GET /categories
  expect status equals 200
  capture body[0].id as categoryId

@orderReturns @orderOps
test "an approved return request refunds the order via a real async job, polled to completion"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /products body { name: unique("Returnable Widget"), price: 20, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api POST /orders/{orderId}/fulfill
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 202
  capture body.jobId as fulfillJobId

  wait until api GET /jobs/{fulfillJobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  api POST /orders/{orderId}/return-request body { reason: "arrived damaged" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  expect body.status equals "requested"
  capture body.id as returnRequestId

  # Deciding is itself always synchronous (200) — only the refund's own async job needs polling.
  api PATCH /return-requests/{returnRequestId} body { decision: "approved", reason: "valid claim" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect body.status equals "approved"
  capture body.refundJobId as refundJobId
  log "return request {returnRequestId} approved, polling refund job {refundJobId}"

  api GET /orders/{orderId}
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect body.status equals "fulfilled"

  wait until api GET /jobs/{refundJobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  api GET /orders/{orderId}
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect body.status equals "refunded"

@orderReturns @orderOps
test "a rejected return request leaves the order untouched — no refund job is ever created"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /products body { name: unique("Return-refused Widget"), price: 20, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api POST /orders/{orderId}/fulfill
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 202
  capture body.jobId as fulfillJobId

  wait until api GET /jobs/{fulfillJobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  api POST /orders/{orderId}/return-request body { reason: "changed my mind" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as returnRequestId

  api PATCH /return-requests/{returnRequestId} body { decision: "rejected", reason: "outside policy window" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect body.status equals "rejected"

  api GET /return-requests/{returnRequestId}
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect body.status equals "rejected"

  # No job at all on this path (decision 7) — the order's status simply never changes. A single
  # GET is sufficient proof (no "stays constant over time" primitive needed, TFLW-GAPS.md's
  # planning-time question — it resolved to "not needed" rather than a new gap).
  api GET /orders/{orderId}
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect body.status equals "fulfilled"

  api PATCH /return-requests/{returnRequestId} body { decision: "approved" }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 409

@orderReturns @orderOps
test "submitting a return request against a non-fulfilled order is a conflict"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /products body { name: unique("Too-early Widget"), price: 20, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  expect body.status equals "pending"
  capture body.id as orderId

  api POST /orders/{orderId}/return-request body { reason: "too early" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 409

@orderReturns @orderOps
test "a duplicate return request on the same order is a conflict, not a second row"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /products body { name: unique("Twice-returned Widget"), price: 20, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api POST /orders/{orderId}/fulfill
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 202
  capture body.jobId as fulfillJobId

  wait until api GET /jobs/{fulfillJobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  api POST /orders/{orderId}/return-request body { reason: "first attempt" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201

  api POST /orders/{orderId}/return-request body { reason: "second attempt" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 409

@orderReturns @authz @orderOps
test "a non-owner cannot submit a return request on someone else's fulfilled order"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as userBToken

  api POST /products body { name: unique("Not-yours Widget"), price: 20, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api POST /orders/{orderId}/fulfill
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 202
  capture body.jobId as fulfillJobId

  wait until api GET /jobs/{fulfillJobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  # A plain 404 (not 403) — deliberately: unlike every other order sub-resource there's no
  # admin-bypass use case for *submitting* a return on someone else's order.
  api POST /orders/{orderId}/return-request body { reason: "not my order" }
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 404

@orderReturns @authz @orderOps
test "only an admin can decide a return request"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /products body { name: unique("Owner-decides-nothing Widget"), price: 20, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api POST /orders/{orderId}/fulfill
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 202
  capture body.jobId as fulfillJobId

  wait until api GET /jobs/{fulfillJobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  api POST /orders/{orderId}/return-request body { reason: "self-service?" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as returnRequestId

  api PATCH /return-requests/{returnRequestId} body { decision: "approved" }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 403
