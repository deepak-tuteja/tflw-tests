# `C108`'s third column, other leg. Identical to `web-storefront-allow.config` except the one line
# under test: the `web` base now names the console the fixture already reaches absolutely.

env local default
  api env TFLW_API_BASE default "http://localhost:4001/v1"
  web env TFLW_WEB_ADMIN_BASE default "http://localhost:8091"
  allow hosts "localhost"
