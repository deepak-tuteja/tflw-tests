# `C118` control. The same project with no `baseline` key: both findings fail their tests, which is
# what makes the other config's green mean the key was read and not that the scan found nothing.

defaults
  authorized target "http://127.0.0.1:4507" reason "arrival-server, this repository's own conformance fixture"

env local default
  api "http://127.0.0.1:4507"
