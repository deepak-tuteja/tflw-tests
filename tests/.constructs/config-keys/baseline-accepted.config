# `C118`. One line more than `baseline-none.config`. `accepted.json` is never committed and never
# hand-written: the grader mints it with `--baseline-write` from a run against the leaking server.

defaults
  authorized target "http://127.0.0.1:4507" reason "arrival-server, this repository's own conformance fixture"
  baseline "./accepted.json"

env local default
  api "http://127.0.0.1:4507"
