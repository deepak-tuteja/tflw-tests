# `S-2a` — axe on every kind and tab, in the page's light and dark themes (tflw `M240` `E`). The
# page's own gate runs the same scan on a fixture; this one runs it on this project, which is where
# the review measured 108 violations.
#
# The theme is picked in the page's own control, the way a reader picks it.

# tflw `M254` (`D1402`) retired the landing: a first visit opens the shell, so the shell at rest —
# the header, every kind's chip, a file open — is the first thing scanned.
test "the shell at rest has no a11y violations"
  let token = env(TFLW_UI_TOKEN)
  open "/?token={token}"
  expect css "[data-header]" is visible
  expect css "[data-kind-chips=all]" is visible
  expect page has no a11y violations

test "API: every tab, in Paper"
  let token = env(TFLW_UI_TOKEN)
  open "/?token={token}#/?kind=api"
  select "Paper" from field "theme"
  expect css "[data-compose-pane]" is visible
  expect page has no a11y violations
  open "/?token={token}#/source?kind=api"
  expect css "[data-source]" is visible
  expect page has no a11y violations
  open "/?token={token}#/run?kind=api"
  expect css "[data-runstrip]" is visible
  expect page has no a11y violations
  open "/?token={token}#/auth?kind=api"
  expect css "[data-auth-identity]" is visible
  expect page has no a11y violations
  open "/?token={token}#/config?kind=api"
  expect css "[data-api-config-text]" is visible
  expect page has no a11y violations

test "API: every tab, in Terminal"
  let token = env(TFLW_UI_TOKEN)
  open "/?token={token}#/?kind=api"
  select "Terminal" from field "theme"
  expect css "[data-compose-pane]" is visible
  expect page has no a11y violations
  open "/?token={token}#/source?kind=api"
  expect css "[data-source]" is visible
  expect page has no a11y violations
  open "/?token={token}#/run?kind=api"
  expect css "[data-runstrip]" is visible
  expect page has no a11y violations
  open "/?token={token}#/auth?kind=api"
  expect css "[data-auth-identity]" is visible
  expect page has no a11y violations
  open "/?token={token}#/config?kind=api"
  expect css "[data-api-config-text]" is visible
  expect page has no a11y violations

test "BROWSER, LOAD and SCANS chips open clean in both themes"
  let token = env(TFLW_UI_TOKEN)
  open "/?token={token}#/?kind=browser"
  select "Paper" from field "theme"
  expect css "[data-compose-pane]" is visible
  expect page has no a11y violations
  open "/?token={token}#/?kind=load"
  expect css "[data-file-row][data-open=yes]" is visible
  expect page has no a11y violations
  open "/?token={token}#/?kind=scan"
  expect css "[data-kind-chips=scan]" is visible
  expect page has no a11y violations
  select "Terminal" from field "theme"
  open "/?token={token}#/?kind=browser"
  expect css "[data-compose-pane]" is visible
  expect page has no a11y violations
  open "/?token={token}#/?kind=load"
  expect css "[data-file-row][data-open=yes]" is visible
  expect page has no a11y violations
  open "/?token={token}#/?kind=scan"
  expect css "[data-kind-chips=scan]" is visible
  expect page has no a11y violations
