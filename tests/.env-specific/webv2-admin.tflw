# testFlow PLAN.md's M7 acceptance corpus (PLAN_WEBV2_TARGETS.md webV2-1): mixed UI/API coverage
# against the SSR admin console (`env webv2Admin`'s `web` base, the Express/EJS app on :8091,
# full-page-nav — a different flake class than the storefront SPA's client-side rehydration races,
# per PLAN_WEBV2_TARGETS.md's own note: no auth race to guard against here, every navigation is a
# real page load carrying the server session cookie).
#
# Both tests establish their own preconditions via real API calls (a dedicated product/review, a
# dedicated ticket) rather than depending on data left over by other tests or by seed data —
# following T3-T5's lesson in webv2-storefront.tflw (seed/other-test state is not a safe premise).
#
# **Lives in `.env-specific/`, not `tests/` (M7 acceptance finding)**: `env` selection is one value
# for the *whole* `tflw run` invocation (SPEC §3.1) — there's no per-file/per-test override. This
# file genuinely needs `web` pointed at :8091 (the admin console), which conflicts with
# `webv2-storefront.tflw`'s need for :8090 (the storefront) within the very same suite. Left at
# `tests/` root, the bare `npx tflw run`/`npm test` discovers it (SPEC's default-discovery walk
# skips only dot-directories) and silently runs it against the *wrong* app under `env local`'s
# default `web` — a real, confirmed failure mode this session hit directly, not a hypothetical.
# Run explicitly instead: `npm run test:webv2-admin` (`tflw run --env webv2Admin
# tests/.env-specific/webv2-admin.tflw`).

test "admin replies to a review through the moderation view"
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken
  api GET /categories
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  capture body[0].id as categoryId
  api POST /products body { name: unique("Admin Reply Widget"), price: 9.99, stock: 5, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as userBToken
  api POST /products/{productId}/reviews body { rating: 3, comment: "Needs improvement." }
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 201

  open "/login"
  fill field "Email" with env(ADMIN_EMAIL)
  fill field "Password" with env(ADMIN_PW)
  click button "Log in"
  expect button "Log out" is visible

  open "/products/{productId}"
  expect text "Needs improvement." is visible
  fill field "Reply" with "Thanks — restocking soon."
  click button "Post reply"
  # a bare `text "…"` is ambiguous here — the just-posted reply's textarea now echoes the same
  # string back as its (now pre-filled) value alongside the rendered "replied" paragraph; scope to
  # the paragraph specifically.
  expect css "p:has-text('Thanks — restocking soon.')" is visible

test "a ticket's full lifecycle: created by a user, assigned by admin, worked by an agent"
  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as userBToken
  api POST /tickets body { subject: unique("Order never arrived"), description: "Placed 5 days ago, still shows pending." }
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 201
  capture body.id as ticketId

  api POST /auth/login body { email: env(AGENT_A_EMAIL), password: env(AGENT_A_PW) }
  expect status equals 200
  capture body.accessToken as agentToken
  api GET /auth/profile
    header "Authorization" is "Bearer {agentToken}"
  expect status equals 200
  capture body.id as agentId

  open "/login"
  fill field "Email" with env(ADMIN_EMAIL)
  fill field "Password" with env(ADMIN_PW)
  click button "Log in"
  expect button "Log out" is visible

  open "/tickets/{ticketId}"
  fill field "Assign to (agent user id)" with {agentId}
  click button "Assign"
  expect text "{agentId}" is visible

  click button "Log out"
  fill field "Email" with env(AGENT_A_EMAIL)
  fill field "Password" with env(AGENT_A_PW)
  click button "Log in"
  expect button "Log out" is visible

  open "/tickets/{ticketId}"
  click button "Start"
  expect text "in_progress" is visible
  click button "Resolve"
  # a bare `text "resolved"` is ambiguous — the status `.badge` and the ticket's own history log
  # entry ("resolved — {actor} — {timestamp}") both contain it; scope to the badge's exact text.
  expect css ".badge:text-is('resolved')" is visible
  fill field "Add comment" with "Investigated and resolved — carrier confirmed delivery today."
  click button "Post comment"
  expect text "Investigated and resolved — carrier confirmed delivery today." is visible
