# `S-3b` (decision 16): the help centre the support page embeds — its own document in an iframe, so
# its search field and its button are reachable only through `within frame`. Support is behind a
# sign-in; user B, whose cart and orders nothing here touches.

import "../../shared/webv2-login.tflw"

@ui @identityOps
test "the embedded help centre answers a search inside its own frame"
  login(env(USER_B_EMAIL), env(USER_B_PW))
  open "/support"
  within frame css "iframe[title='Help centre']"
    fill field "Search help" with "invoice"
    expect text "Invoices: download yours from the order page." is visible
    expect text "Returns: you can return an item within 30 days of delivery." is hidden

@ui @identityOps
test "the help centre's feedback is recorded inside the frame, not on the page around it"
  login(env(USER_B_EMAIL), env(USER_B_PW))
  open "/support"
  within frame css "iframe[title='Help centre']"
    click button "This helped"
    expect text "Thanks for telling us." is visible
  expect css "#support-heading" is visible
