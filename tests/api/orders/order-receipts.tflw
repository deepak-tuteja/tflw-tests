# order-receipts.tflw — M32 (plan_v2.md Part R Cluster B): the first genuinely binary response
# body in this API. `GET /orders/{id}/receipt` serves a real, hand-assembled PDF (FlateDecode-
# compressed content stream, same as virtually every real-world PDF), same ownership scoping as
# the rest of the order sub-resources (`order-items.tflw`'s pattern). M36 (tflw M24, gap #17)
# closed the original gap here — tflw can now assert the exact bytes via `body bytes`/`matches
# file`, not just headers/status; see the round-trip test below and TFLW-GAPS.md gap #17 (Fixed).

use "../../helpers/save-temp-file.ts"

before
  api GET /categories
  expect status equals 200
  capture body[0].id as categoryId

  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as userBToken

  api POST /products body { name: unique("Receipt Widget"), price: 9.99, stock: 10, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

@orderReceipts @orders @orderOps @api
test "a placed order's receipt is a real PDF with the right headers"
  api POST /orders body { items: [{ productId: {productId}, quantity: 2 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId
  log "order {orderId} placed, fetching its receipt as a real PDF"

  api GET /orders/{orderId}/receipt
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect header "content-type" equals "application/pdf"
  expect header "content-disposition" contains "receipt-{orderId}.pdf"

@orderReceipts @orders @orderOps @api
test "a receipt's exact bytes round-trip byte-for-byte across two fetches (gap #17)"
  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  # order-receipt.util.ts's only variable input is the order's own persisted createdAt — no
  # new Date()/randomness at render time — so the same order's receipt is byte-identical across
  # repeated fetches. Fetch once, save the exact bytes received to a scratch file, fetch again,
  # and compare the second fetch against that file — proves real round-trip byte stability
  # without depending on a committed fixture ever staying in sync with seed data. (`has count`
  # can't take this proof further: it needs a literal NUMBER token, not a `{var}` — there's no way
  # to compare `body bytes`' length against a header captured moments earlier in this grammar
  # today. Not a gap in practice here — `matches file`'s own byte-equality check is strictly
  # stronger than a length check anyway, since Buffer.equals() requires equal length too.)
  api GET /orders/{orderId}/receipt
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  capture body bytes as receiptBytes
  let scratchPath = save temp file(receiptBytes)

  api GET /orders/{orderId}/receipt
    header "Authorization" is "Bearer {userAToken}"
  # The path comes from `scratchPath`, which the JS helper above returned after writing the file —
  # so the assertion names the file that was actually just written, rather than a literal repeating
  # a path the helper also hard-codes. Those two could drift; now they cannot.
  #
  # This line is the whole reason `matches file` interpolates at all (tflw `A4-OS-09`/M101/D174).
  # Through v0.1 it was the one file operand that read its literal text while `body from`, `upload`
  # and `drop file` all called `evalValue`, so this suite had to write the path out twice and say
  # why in a comment. It is also why TF043 has two severities: as a literal, this path was
  # statically known and named a file the *next* line creates, and TF043 shipped as an error for
  # the length of the M97/M98 stack, which made this whole suite unrunnable — see tflw M97e/D147
  # and the header of tests/.checkonly/missing-referenced-file.tflw.
  #
  # An interpolated path is not statically known, so the checker now skips this line entirely and
  # the standing TF043 warning is gone. That is the correct report about a path the run computes —
  # not knowable is not known-bad. The warning tier still matters and is still covered; its fixture
  # lives in tests/.checkonly/missing-referenced-file.tflw, deliberately, rather than depending on
  # this suite continuing to have a workaround in it.
  expect body bytes matches file "{scratchPath}"

@orderReceipts @authz @orderOps @api
test "a receipt is scoped exactly like the parent order"
  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api GET /orders/{orderId}/receipt
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 403

  api GET /orders/{orderId}/receipt
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200

@orderReceipts @orders @orderOps @api
test "a receipt for a nonexistent order is a clean 404"
  let orderId = random uuid
  api GET /orders/{orderId}/receipt
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 404

@orderReceipts @auth @orderOps @api
test "fetching a receipt without auth is rejected"
  api POST /orders body { items: [{ productId: {productId}, quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api GET /orders/{orderId}/receipt
  expect status equals 401
