# authz.tflw — user-scoped resources ("your orders != my orders"): three distinct identities
# (admin + two ordinary users, seeded by apiV2's seed script) prove ownership-scoping is a real
# authorization check, not just "any authenticated user can see anything". RBAC (role-gated
# endpoints) is covered in auth.tflw (`/orders/all`); this file is about per-resource ownership.
#
# All three identities log in ad hoc rather than via a cached `session`, and the reason is NOT the
# one this comment used to give. It cited SPEC §3.3's one-session-per-test limit; decision 96
# shipped multi-session tests (`test "..." as admin, userA`) and that limit no longer exists
# (`M130-02`, corrected by `M147f`). The real reason is that this file is the CONTROL the generated
# authorization matrix is graded against, and a control must not share an idiom with the thing it
# grades: porting it to the shape `M130c`'s generator emits would destroy the one instrument that
# would catch that generator being confidently wrong. It also keeps a live example of the inline-
# identity idiom `TF062` refuses (D308), which the checker's fixture cannot supply — which is why
# this file is deliberately unreachable by Tier 2 rather than accidentally so.

before
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as userAToken

  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as userBToken

  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

  api GET /categories
  expect status equals 200
  capture body[0].id as categoryId

  # A dedicated product with its own stock (M15) — this file's 4 tests each order 1 unit; the
  # old `GET /products` + `body[0].id` grabbed *whatever* product currently sorted first in the
  # whole catalog, which risks colliding with some other test's low-remaining-stock item.
  api POST /products body { name: unique("Authz Widget"), price: 10, stock: 10, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

@authz @identityOps @api
test "user B cannot read user A's order"
  api POST /orders body { items: [{ productId: "{productId}", quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId
  log "order {orderId} placed by user A, about to be probed by user B"

  api GET /orders/{orderId}
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 403

@authz @identityOps @api
test "user A can read her own order"
  api POST /orders body { items: [{ productId: "{productId}", quantity: 1 }] }
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 201
  capture body.id as orderId

  api GET /orders/{orderId}
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect body.status equals "pending"

@authz @identityOps @api
test "an admin can read any user's order"
  api POST /orders body { items: [{ productId: "{productId}", quantity: 1 }] }
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 201
  capture body.id as orderId

  api GET /orders/{orderId}
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200

@authz @identityOps @api
test "user A only sees her own orders in her order list, never user B's"
  api POST /orders body { items: [{ productId: "{productId}", quantity: 1 }] }
    header "Authorization" is "Bearer {userBToken}"
  expect status equals 201
  capture body.id as bOrderId

  api GET /orders
    header "Authorization" is "Bearer {userAToken}"
  expect status equals 200
  expect all body.id not equals "{bOrderId}"
