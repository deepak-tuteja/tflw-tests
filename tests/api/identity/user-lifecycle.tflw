# user-lifecycle.tflw — PLAN_LIFECYCLE.md L3: one long, realistic chain composing L1's attribute
# bag + optimistic concurrency and L2's async self-deletion, rather than isolated protocol-corner
# tests (per this initiative's north star). Always a fresh throwaway user (`unique email`/`random
# password`, decision 8) — never the shared seeded fixtures, since this scenario ends by
# soft-deleting the account it creates.

before
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

@lifecycle @identityOps @api
test "a user's full attribute lifecycle: enrich, conflict, retry, redact, then soft async self-deletion"
  let email = unique email
  let pw = random password
  api POST /auth/register body { name: unique("Lifecycle User"), email: {email}, password: {pw} }
  expect status equals 201
  capture body.accessToken as token
  log "user registered, starting the full attribute lifecycle for token {token}"

  api GET /users/me
    header "Authorization" is "Bearer {token}"
  expect status equals 200
  capture header "etag" as etag1

  # Enrich with a long attribute list.
  api PATCH /users/me body { nickname: "lifer", theme: "dark", locale: "en-US", newsletter: true, tier: "free", referrer: "organic", betaFlags: { newDash: true } }
    header "Authorization" is "Bearer {token}"
    header "If-Match" is "{etag1}"
  expect status equals 200
  expect body.attributes matches subset { nickname: "lifer", tier: "free" }
  capture header "etag" as etag2

  # A second update lands first (simulating a concurrent writer) using the ETag both it and the
  # stale retry below started from.
  api PATCH /users/me body { tier: "pro" }
    header "Authorization" is "Bearer {token}"
    header "If-Match" is "{etag2}"
  expect status equals 200
  expect body.attributes.tier equals "pro"

  # The original writer's now-stale ETag is rejected — the real conflict, not injected flakiness.
  api PATCH /users/me body { locale: "fr-FR" }
    header "Authorization" is "Bearer {token}"
    header "If-Match" is "{etag2}"
  expect status equals 412
  expect body matches subset { type: "about:blank", title: "Precondition Failed", status: 412 }

  # Refetch, then retry succeeds against the current ETag.
  api GET /users/me
    header "Authorization" is "Bearer {token}"
  expect status equals 200
  capture header "etag" as etag3

  api PATCH /users/me body { locale: "fr-FR" }
    header "Authorization" is "Bearer {token}"
    header "If-Match" is "{etag3}"
  expect status equals 200
  expect body.attributes.locale equals "fr-FR"
  capture header "etag" as etag4

  # RFC 7386 null-delete a subset of attributes via merge-patch. `equals` can't take an inline
  # object literal (TFLW-GAPS.md gap #18 — only `matches subset {...}`/`body {...}` get real
  # object-literal grammar), so "exactly the right keys survived" is proven by capturing this
  # response's own `attributes` and asserting the follow-up GET reproduces it exactly — a full
  # deep-equal against a live captured value, not a hand-typed literal.
  api PATCH /users/me body { referrer: null, betaFlags: null }
    header "Authorization" is "Bearer {token}"
    header "If-Match" is "{etag4}"
  expect status equals 200
  expect body.attributes matches subset { nickname: "lifer", theme: "dark", locale: "fr-FR", newsletter: true, tier: "pro" }
  capture body.attributes as expectedAttrs

  api GET /users/me
    header "Authorization" is "Bearer {token}"
  expect status equals 200
  expect body.attributes equals {expectedAttrs}

  api DELETE /users/me
    header "Authorization" is "Bearer {token}"
  expect status equals 202
  expect body.status equals "processing"
  capture body.id as jobId

  # The caller's own access token is already dead by now — startAccountDeletion sets
  # deactivatedAt synchronously, before this response was even sent, and assertActive rejects it
  # on the very next request. Poll as admin instead, same reasoning as jobs.tflw's
  # stranger-scoping test using the actual resource owner's token rather than the triggering caller.
  wait until api GET /jobs/{jobId}
    header "Authorization" is "Bearer {adminToken}"
    expect body.status equals "completed"

  api POST /auth/login body { email: {email}, password: {pw} }
  expect status equals 401
  expect body.detail equals "account has been deactivated"

  api GET /users/me
    header "Authorization" is "Bearer {token}"
  expect status equals 401
