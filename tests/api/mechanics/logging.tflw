# logging.tflw — M51 (PLAN_LOG_CONSUME.md): proves tflw's `log` statement (M27/M28, ../testFlow/
# PLAN_LOG.md) end to end against a real run — config-default resolution, override-not-accumulate
# semantics, and "an explicit `to …` clause always wins" (SPEC.md §3.8/§7.7).
#
# Run under `--env logConfig` (or `npm run test:logging`) — its own dedicated env (tflw.config):
# `log destination console` / `log level warn`, distinct from the built-in default (`both`/
# `debug`) so this file actually exercises the override, not just the default.
#
# What each line below is *for* (level/destination filtering itself isn't visible to `expect` —
# `log` never affects pass/fail, SPEC.md §7.7 — so the real proof lives in
# `scripts/verify-logging.mjs`, which re-runs this exact file under several `--log-output`/
# `--log-level` combinations and reads `report/results.json`/console stdout/`report.html` as
# ground truth, same "script it, don't trust a one-time manual check" discipline as
# `verify-safety-flags.mjs`):
#   - the bare `log debug "…"` line: below `logConfig`'s own "warn" threshold — recorded in
#     results.json regardless, but never rendered to console/html at this env's default level.
#   - the bare `log warn "…"` line: clears the threshold, inherits `logConfig`'s `console`
#     destination — renders to console, not to html.
#   - the `log error "…" to html` line: an explicit destination always overrides config (and,
#     per verify-logging.mjs, a CLI `--log-output` override too) — renders to html regardless of
#     `logConfig`'s console-only default, never to console even though its level clears threshold.

@logging @api
test "log resolves against configured destination/level, and an explicit `to` always wins"
  let orderId = unique("ord")
  log debug "raw payload for order {orderId}: below the configured warn threshold"
  log warn "stock check for order {orderId}: running low"
  log error "checkout failed for order {orderId}" to html
