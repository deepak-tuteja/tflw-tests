# quantifiers.tflw — `any`/`all` over the array-returning /orders/{id}/items endpoint.
#
# Redesigned for v2 (plan_v2.md Part E, M12): v1's asserted shape (`body.orders.total`/`.qty`)
# doesn't exist in v2 at all — `GET /orders` returns a flat `Order[]` with no top-level
# `total`/`qty`; those concepts now live inside each order's nested `items[]`. Quantifying
# directly over `GET /orders/{id}/items` (a genuinely flat array, same endpoint order-items.tflw
# exercises) is the first test. The second quantifies into a *second*, nested array
# (`GET /orders/all`'s embedded `items[]`) — TFLW-GAPS.md gap #11, which this redesign surfaced
# and tflw `G8` closed: the path now fans out across every array it crosses.
#
# Uses an inline admin login (not `as admin`), fixed during M13 — the same cumulative-suite-
# timing issue as schema-and-shape.tflw/jobs.tflw (M12/M13): as the suite has grown, this file
# now also sorts late enough for the cached `admin` session's 5s-TTL token to be stale here.

before
  api GET /categories
  expect status equals 200
  capture body[0].id as categoryId

  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as adminToken

@crud @quantifiers @catalogOps @api
test "quantifiers over one order's items"
  api POST /products body { name: unique("Quant Widget A"), price: 5, stock: 10, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productIdA

  api POST /products body { name: unique("Quant Widget B"), price: 5, stock: 10, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productIdB

  api POST /orders body { items: [{ productId: {productIdA}, quantity: 3 }, { productId: {productIdB}, quantity: 1 }] }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as orderId
  log "order {orderId} placed, checking quantifiers over its items"

  api GET /orders/{orderId}/items
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect all body.quantity is greater than 0
  expect any body.quantity equals 3
  expect any body matches subset { productId: "{productIdA}", quantity: 3 }

# Gap #11, closed by tflw `G8`: every item of every order is a leaf. The product is this test's own,
# so exactly one leaf across the whole list can carry its id — the assertion failed before `G8` with
# that item present, reading `.productId` off each order's `items` array as `undefined`.
@crud @quantifiers @catalogOps @api
test "quantifiers reach into every order's nested items"
  api POST /products body { name: unique("Nested Quant Widget"), price: 5, stock: 10, categoryId: {categoryId} }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201
  capture body.id as productId

  api POST /orders body { items: [{ productId: {productId}, quantity: 3 }] }
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 201

  api GET /orders/all
    header "Authorization" is "Bearer {adminToken}"
  expect status equals 200
  expect any body.items.productId equals "{productId}"
  expect all body.items.quantity is greater than 0
