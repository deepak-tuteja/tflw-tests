node_modules/
report/
report-by-phase/
*.log
.env
vendor/*.tgz
.testflow-tests.pids

# gap #17 (M36) scratch space — tests/helpers/save-temp-file.ts writes a `body bytes` round-trip
# proof file here every run; never a committed fixture.
tests/.scratch/

# TLS sidecar's CA/server/client certs — regenerated fresh at every container start
# (M22, enterprise arc cluster 1), nothing here is ever meant to be a stable fixture.
nginx/certs/

# Internal dev-tracking docs (decision log + build tracker + gap-discovery findings) — same
# approach as ../testFlow's own .gitignore: not part of the public project, local planning
# artifacts only. Wildcarded (was: individually-named PLAN_*.md entries) after PLAN_LIFECYCLE.md
# turned up as an untracked straggler with no matching rule — every PLAN_*.md is local-only now,
# no case-by-case exceptions (PLAN_GAPS_16_17.md was one; untracked via `git rm --cached` in the
# same change that added this line).
PLAN.md
plan_v2.md
PLAN_*.md
PROGRESS.md
TFLW-GAPS.md
TFLW-FEATURE-GAPS.md
HELPERS.md

# D380's sweep builds a disposable annotated copy of tests/ here (scripts/sweep-input-volume.mjs).
.sweep-input/
.regression-workers/

# The UI's own scratch files. `.play.tflw` is what the pane writes when you press ▶ on an
# unsaved edit, and `.scratch.tflw` is where `+ new test` lands before it is named — both are
# copies of whatever was on screen, so `tests/ui/storefront/.play.tflw` is a real E2 test with a
# recorded session appended to it. Ignored at any level, which is what keeps `M224`'s and
# `M228`'s acceptance corpora committable without their scratch going with them.
.play.tflw
.scratch.tflw

# The vendored tarball's provenance (M184c/D955) — written by the packer beside the `.tgz` that
# is already ignored a few lines up, regenerated on every pack. It records what the packer was
# TOLD it was building from, which is a local fact about a local pack.
vendor/packed-from.json
