# Copy to .env (gitignored) before `node cli.mjs start`.

# Postgres (used by docker-compose and apiV2's TypeORM connection)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=testflow_tests

# JWT (M1 — access/refresh auth). Two secrets, four TTLs: ACCESS_SECRET signs both the bearer
# access token and the cookie session token (both "access-class"); REFRESH_SECRET signs both the
# bearer refresh token and the cookie session_refresh token (both "refresh-class").
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=5s
JWT_REFRESH_TTL=1h
JWT_SESSION_TTL=1h
JWT_SESSION_REFRESH_TTL=2h

# Seeded identities (admin + two distinct users, for authz cross-user tests)
ADMIN_EMAIL=admin@example.com
ADMIN_PW=admin-pw-123
USER_A_EMAIL=alice@example.com
USER_A_PW=alice-pw-123
USER_B_EMAIL=bob@example.com
USER_B_PW=bob-pw-123

# Two distinct AGENTs (PLAN_TICKETING.md T1) — needed for cross-agent authz cases (an agent can't
# reassign or see another agent's ticket).
AGENT_A_EMAIL=carol@example.com
AGENT_A_PW=carol-pw-123
AGENT_B_EMAIL=dave@example.com
AGENT_B_PW=dave-pw-123

# PLAN_ENTERPRISE_REGRESSION.md E3 — two orgs' worth of dedicated seed users spanning all 3
# org roles (owner/admin/member), kept separate from alice/bob so the org-scoping retrofit never
# changes what any pre-E3 test already asserted about them.
ORG_A_OWNER_EMAIL=erin@example.com
ORG_A_OWNER_PW=erin-pw-123
ORG_A_ADMIN_EMAIL=frank@example.com
ORG_A_ADMIN_PW=frank-pw-123
ORG_A_MEMBER_EMAIL=grace@example.com
ORG_A_MEMBER_PW=grace-pw-123
ORG_B_OWNER_EMAIL=heidi@example.com
ORG_B_OWNER_PW=heidi-pw-123
ORG_B_ADMIN_EMAIL=ivan@example.com
ORG_B_ADMIN_PW=ivan-pw-123
ORG_B_MEMBER_EMAIL=judy@example.com
ORG_B_MEMBER_PW=judy-pw-123

# PLAN_ENTERPRISE_REGRESSION.md E4 — inventory-service's own Postgres (a separate instance,
# decision 1) and the URL apiV2 calls it at over the docker network. All optional: docker-compose.yml
# already defaults every one of these if unset.
INV_DB_USER=postgres
INV_DB_PASSWORD=postgres
INV_DB_NAME=inventory_service
INVENTORY_SERVICE_URL=http://inventory-service:4002/v1

# OAuth2 client-credentials grant (M22, enterprise arc cluster 1 — dogfoods tflw's `oauth2`
# session sugar). Two clients: a normal-TTL one and a short-TTL one, so tests can exercise both
# plain token reuse and tflw's proactive re-fetch-before-expiry path.
OAUTH_CLIENT_ID=tflw-oauth-client
OAUTH_CLIENT_SECRET=tflw-oauth-secret
OAUTH_ACCESS_TTL=1h
OAUTH_SHORT_CLIENT_ID=tflw-oauth-short-client
OAUTH_SHORT_CLIENT_SECRET=tflw-oauth-short-secret
OAUTH_SHORT_ACCESS_TTL=5s
