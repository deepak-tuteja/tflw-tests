# The pentest arc's acceptance corpus (testFlow M128c, PLAN_M128_PENTEST_TIER1.md D295) — its own
# config root, like every other directory under `tflw-acceptance/`, so `npm run check:acceptance`
# discovers it without anyone maintaining a list.
#
# Two envs, because several rules answer differently on the two schemes and **that difference is the
# thing being measured**. `sec/hsts-missing` and `sec/cookie-not-secure` fire over TLS and are
# not-applicable over plaintext; `sec/server-version-disclosure` is the other way round (nginx
# advertises a version, Express does not). A corpus with one base could not tell a rule that stayed
# silent from a rule that never ran.
#
# `VULN_MODE=1` is required — most positives come from `apiV2/src/vuln/`, which is absent from the
# app entirely without it (D293). See `../../VULNS.md` for the ledger this corpus is graded against,
# and `../../scripts/verify-security-acceptance.mjs` for the grader.
#
# **M130c adds the arc's second tier to this same corpus** (PLAN_M130_PENTEST_TIER2.md D319) — the
# `authorization violations` matcher, graded the same three ways. It shares the config rather than
# getting its own because the two tiers disagree about the same responses in a way that is worth
# having visible in one place: Tier 1 judges a single response's hygiene, Tier 2 re-issues that
# response's request under other identities and compares. The new declarations below are the probe
# set (`peer`, `admin privileged`) and `probe mutating` on the TLS env only.
#
#   VULN_MODE=1 node cli.mjs start
#   cd tflw-acceptance/security && npx tflw run --env secureLocal
#   npm run verify:security-acceptance     # the D295 + D319 measurement, both envs, both directions

require env USER_A_EMAIL, USER_A_PW, USER_B_EMAIL, USER_B_PW, ADMIN_EMAIL, ADMIN_PW

# M131b (D347). `public-target/` holds one file whose whole job is to be **refused** under two of
# three invocations, so it must not be discovered: `npm run check:acceptance` runs `tflw check` over
# every corpus root, and a fixture that is supposed to fail the checker would report this corpus red
# for working. `scripts/verify-security-acceptance.mjs` names the file explicitly, which `exclude`
# deliberately does not affect (SPEC §3.9).
exclude "public-target"

# The TLS base: M22's plain https listener (8443), through nginx. Everything about the pack that
# concerns transport is only observable here.
env secureLocal default
  api "https://localhost:8443/v1"
  # The sidecar's cert is regenerated per container start and signed by a throwaway CA, so there is
  # no stable trust root to point `NODE_EXTRA_CA_CERTS` at. Note this also governs the TLS *probe*:
  # it verifies certificates exactly when the run's requests do (M128c).
  insecure true
  allow hosts "localhost"
  # D21 layer 2, and the thing that permits any of the assertions in this directory to run at all.
  # Origin-scoped: the declaration below authorizes 8443 and nothing else, which is why the
  # plaintext env has its own.
  authorized target "https://localhost:8443" reason "self-hosted dogfood target in this repo, started by ./cli.mjs"
    # M130c (D311). The **opt-in half** of the mutating-probe pair. `GET`/`HEAD`/`OPTIONS` are probed
    # without asking; anything else is `not probed` until a target says otherwise, because permission
    # to read a host as a stranger is not permission to write to it. Declared here and *not* on the
    # plaintext env below, so this one corpus demonstrates both halves against the same app — the
    # same two-base trick M128c used for the scheme-dependent hygiene rules, reused for a policy
    # difference instead of a transport one.
    #
    # This genuinely deletes orders (`DELETE /vuln/orders/:id`, V8). That is not a side effect to be
    # tolerated, it is the argument: a flag that let a scanner write to a host is worth an explicit
    # line in a config, and the damage being real is what makes the line mean something.
    probe mutating

# The plaintext base: straight to the app, no sidecar. Carries every not-applicable case the scheme
# produces, and `server-version-disclosure`'s negative.
env plaintext
  api "http://localhost:4001/v1"
  allow hosts "localhost"
  # **No `probe mutating` here, deliberately** — this is the default half of D311. The corpus asserts
  # against this env that a `DELETE` plant comes back `not probed` and that the report *says so*
  # rather than passing quietly, which is the failure mode a boolean oracle would have.
  authorized target "http://localhost:4001" reason "self-hosted dogfood target in this repo, started by ./cli.mjs"

# --- M131b: the public-target gate (D21 §3.2(3), D347) -----------------------------------------
#
# **The only env in this repo that names a host outside the private address ranges, and it names one
# that cannot exist.** RFC 2606 reserves `.invalid` precisely so that a name can be written down and
# never resolve — which, under tflw's *literal* address classification (no DNS, ever), is `public`
# with no lookup. That is what lets an offline corpus grade a control about the internet.
#
# Both of the other gates are satisfied here on purpose, and each for a reason the evidence depends
# on. `allow hosts` names the host, so a refusal cannot be the allowlist's. `authorized target`
# declares the origin, so a refusal cannot be `TF060`'s. What is left is the one gate under test:
# the affirmation that has to arrive on the **command line**, where nothing in this file can put it.
# Strip either line and the third case still goes red — for the wrong reason, and the proof would
# quietly become vacuous.
#
# There is deliberately no `probe mutating` and no `privileged` here: the assertion never gets far
# enough for either to matter, and adding them would suggest they were part of what is being shown.
env publicTarget
  api "https://staging.example.invalid/v1"
  allow hosts "staging.example.invalid"
  authorized target "https://staging.example.invalid" reason "acceptance fixture for the public-target gate; RFC 2606 guarantees this name never resolves, so nothing is ever reached"

# Cookie auth rather than bearer, deliberately: `sec/authenticated-response-cacheable`'s precondition
# is "the request carried session or bearer credentials", and a cookie session exercises the half
# that comes from tflw's own jar rather than from a header the test wrote.
session shopper
  api POST /auth/session-login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200

# --- M130c: the principals Tier 2 probes with -------------------------------------------------
#
# Tier 2 re-issues the owner's request under every *other* declared session, so the probe set is a
# property of this file rather than of any test. For a `shopper`-owned assertion here it is
# `{peer, anonymous}` — `admin` is excluded by the line below, and `anonymous` is built in and always
# probed (D306). The root `tflw.config` also declares two `oauth2` sessions, which is why D319's
# measured cost for the *dogfood* suite is four extra requests per assertion site and the cost here
# is two: the price is a property of the config, and quoting one repo's number for the other would
# be wrong.
#
# **`shopper` deliberately stays a cookie session** (`M130-01`). A cookie-borne principal cannot make
# a mutating probe — `AnyAuthGuard` wants an `X-CSRF-Token` a `session` block never exposes — and the
# right answer is to probe anyway and report the refusal as *inconclusive*, not to skip it. The app
# most worth catching is the one with cookie auth and no CSRF defence at all; a pre-flight skip would
# decline to probe exactly that app. Keeping the owner on cookies keeps that path exercised.

# The other ordinary user — the identity the leaks leak *to*. Bearer, not cookie: as the probing
# principal on a `DELETE`, a cookie-borne `peer` would be refused for CSRF before authorization was
# ever consulted, and V8's plant would read as correctly-denied when it was never asked (D317's
# correction, made against the running app rather than on paper).
session peer
  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"

# **`privileged`, and this is the whole reason the keyword exists.** An administrator legitimately
# reads other people's orders. Probe as one and every ownership-scoped route in the app returns the
# owner's resource to a non-owner, which is *true* and useless — a finding about the role model, not
# about a boundary. Excluded from every probe set, and announced on each assertion rather than
# quietly dropped, so a reader can see the probe set shrink and why.
#
# It is a claim about authority, not a speed knob: marking every session privileged empties the probe
# set of real identities and lands the assertion in D285's no-power-to-fail branch (`TF063`), which
# is the checker refusing to let a suite buy silence with a keyword.
session admin privileged
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"
