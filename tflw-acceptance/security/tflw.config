# The pentest arc's acceptance corpus (testFlow M128c, PLAN_M128_PENTEST_TIER1.md D295) — its own
# config root, like every other directory under `tflw-acceptance/`, so `npm run check:acceptance`
# discovers it without anyone maintaining a list.
#
# Two envs, because several rules answer differently on the two schemes and **that difference is the
# thing being measured**. `sec/hsts-missing` and `sec/cookie-not-secure` fire over TLS and are
# not-applicable over plaintext; `sec/server-version-disclosure` is the other way round (nginx
# advertises a version, Express does not). A corpus with one base could not tell a rule that stayed
# silent from a rule that never ran.
#
# `VULN_MODE=1` is required — most positives come from `apiV2/src/vuln/`, which is absent from the
# app entirely without it (D293). See `../../VULNS.md` for the ledger this corpus is graded against,
# and `../../scripts/verify-security-acceptance.mjs` for the grader.
#
# **M130c adds the arc's second tier to this same corpus** (PLAN_M130_PENTEST_TIER2.md D319) — the
# `authorization violations` matcher, graded the same three ways. It shares the config rather than
# getting its own because the two tiers disagree about the same responses in a way that is worth
# having visible in one place: Tier 1 judges a single response's hygiene, Tier 2 re-issues that
# response's request under other identities and compares. The new declarations below are the probe
# set (`peer`, `admin privileged`) and `probe mutating` on the TLS env only.
#
#   VULN_MODE=1 node cli.mjs start
#   cd tflw-acceptance/security && npx tflw run --env secureLocal
#   npm run verify:security-acceptance     # the D295 + D319 measurement, both envs, both directions

require env USER_A_EMAIL, USER_A_PW, USER_B_EMAIL, USER_B_PW, ADMIN_EMAIL, ADMIN_PW

# M131b (D347). `public-target/` holds one file whose whole job is to be **refused** under two of
# three invocations, so it must not be discovered: `npm run check:acceptance` runs `tflw check` over
# every corpus root, and a fixture that is supposed to fail the checker would report this corpus red
# for working. `scripts/verify-security-acceptance.mjs` names the file explicitly, which `exclude`
# deliberately does not affect (SPEC §3.9).
exclude "public-target"

# The TLS base: M22's plain https listener (8443), through nginx. Everything about the pack that
# concerns transport is only observable here.
env secureLocal default
  api "https://localhost:8443/v1"
  # The sidecar's cert is regenerated per container start and signed by a throwaway CA, so there is
  # no stable trust root to point `NODE_EXTRA_CA_CERTS` at. Note this also governs the TLS *probe*:
  # it verifies certificates exactly when the run's requests do (M128c).
  insecure true
  allow hosts "localhost"
  # D21 layer 2, and the thing that permits any of the assertions in this directory to run at all.
  # Origin-scoped: the declaration below authorizes 8443 and nothing else, which is why the
  # plaintext env has its own.
  authorized target "https://localhost:8443" reason "self-hosted dogfood target in this repo, started by ./cli.mjs"
    # M130c (D311). The **opt-in half** of the mutating-probe pair. `GET`/`HEAD`/`OPTIONS` are probed
    # without asking; anything else is `not probed` until a target says otherwise, because permission
    # to read a host as a stranger is not permission to write to it. Declared here and *not* on the
    # plaintext env below, so this one corpus demonstrates both halves against the same app — the
    # same two-base trick M128c used for the scheme-dependent hygiene rules, reused for a policy
    # difference instead of a transport one.
    #
    # This genuinely deletes orders (`DELETE /vuln/orders/:id`, V8). That is not a side effect to be
    # tolerated, it is the argument: a flag that let a scanner write to a host is worth an explicit
    # line in a config, and the damage being real is what makes the line mean something.
    probe mutating
    # M134c (D372/D398). **`probe oversized` here and `probe traversal` on the plaintext env below,
    # and the split is forced by the target rather than chosen.** It is a better arrangement than the
    # one D398 planned — each opt-in now has a granted env *and* a withheld env, so one corpus
    # demonstrates all four states — but the reason it is split this way is measured, not aesthetic:
    #
    # **nginx answers `400` to the traversal payload before it ever reaches the app.** A reverse
    # proxy decodes and normalises the URI, so `..%2f..%2f..%2f..%2fetc%2fpasswd` never arrives at
    # `V11` through the sidecar. Granting `probe traversal` here would send four probes per site,
    # collect four `400`s, and report the rule as applicable-and-silent — a rule that looks tested
    # and is not. It is granted on the listener where its positive is actually reachable.
    #
    # The withheld half is what makes the not-applicable state observable: with `traversal` ungranted
    # here, `sec/path-traversal-read` stands down and the report says *`traversal` payloads need
    # `probe traversal` under this `authorized target`*. That sentence is the closest this arc gets
    # to naming a not-applicable rule and its reason (`M128-01`), and it only exists on a run where
    # the class was refused. A config granting everything everywhere would never print it.
    #
    # `probe oversized` sends a 64 KiB value — D21 layer 4's "resource exhaustion" category, which is
    # why it is a word somebody has to type rather than a default. Its positive (`V13`, a body leaf)
    # is reachable through the sidecar, so this is its env.
    probe oversized

# The plaintext base: straight to the app, no sidecar. Carries every not-applicable case the scheme
# produces, and `server-version-disclosure`'s negative.
env plaintext
  api "http://localhost:4001/v1"
  allow hosts "localhost"
  # **No `probe mutating` here, deliberately** — this is the default half of D311. The corpus asserts
  # against this env that a `DELETE` plant comes back `not probed` and that the report *says so*
  # rather than passing quietly, which is the failure mode a boolean oracle would have.
  #
  # **And no `probe oversized` here** (M134c, D398) — `V13`'s oversized probe is never sent under
  # this env, so `sec/oversized-input-accepted` stands down and the report names the missing word.
  # The mirror image of the sidecar env above, which withholds `traversal` instead.
  authorized target "http://localhost:4001" reason "self-hosted dogfood target in this repo, started by ./cli.mjs"
    # **`probe traversal` is here and not on the sidecar env, because this is the only listener where
    # its positive can be reached.** nginx returns `400` to `..%2f..%2f..%2f..%2fetc%2fpasswd` — a
    # reverse proxy decodes and normalises the URI, and the payload never arrives at `V11` at all.
    # That is the app's *deployment* defending it rather than the app, which is worth knowing and is
    # exactly the kind of thing a scan run against only one base would never learn.
    probe traversal

  # --- M137f: the two webV2 origins the spider walks (tflw D442/D483) --------------------------
  #
  # **Declared and deliberately without `probe mutating`.** The admin console is a real app with real
  # forms — `POST /login`, `POST /logout`, the create/update forms behind auth — and a spider
  # enumerates every one of them. Withholding the opt-in is what makes this corpus demonstrate
  # `D465` on a *browser* surface as well as an API one: the forms are discovered, disclosed and not
  # sent, and the number appears in the crawl's surface line rather than in a sentence in a plan.
  #
  # The storefront on 8090 is authorized for a different reason: the walk there is expected to find
  # **nothing**, and an origin that was never authorized would have been refused by `TF060` before it
  # could demonstrate that. A blind spot has to be reached to be reported.
  authorized target "http://localhost:8091" reason "self-hosted webV2 admin console in this repo, started by ./cli.mjs — the spider's SSR target"
  authorized target "http://localhost:8090" reason "self-hosted webV2 storefront in this repo, started by ./cli.mjs — the spider's SPA blind-spot control"
  # Named services rather than absolute URLs in the steps below. `TF057` warns that an absolute URL
  # will not move with `--env`, and it is right to: the console is a second origin this env reaches,
  # which is what a service *is* (SPEC §3.1). Writing it here also means the two spider roots and the
  # session that establishes the cookie all name one declaration instead of repeating a host.
  api adminConsole "http://localhost:8091"
  api storefront "http://localhost:8090"

# --- M131b: the public-target gate (D21 §3.2(3), D347) -----------------------------------------
#
# **The only env in this repo that names a host outside the private address ranges, and it names one
# that cannot exist.** RFC 2606 reserves `.invalid` precisely so that a name can be written down and
# never resolve — which, under tflw's *literal* address classification (no DNS, ever), is `public`
# with no lookup. That is what lets an offline corpus grade a control about the internet.
#
# Both of the other gates are satisfied here on purpose, and each for a reason the evidence depends
# on. `allow hosts` names the host, so a refusal cannot be the allowlist's. `authorized target`
# declares the origin, so a refusal cannot be `TF060`'s. What is left is the one gate under test:
# the affirmation that has to arrive on the **command line**, where nothing in this file can put it.
# Strip either line and the third case still goes red — for the wrong reason, and the proof would
# quietly become vacuous.
#
# There is deliberately no `probe mutating` and no `privileged` here: the assertion never gets far
# enough for either to matter, and adding them would suggest they were part of what is being shown.
env publicTarget
  api "https://staging.example.invalid/v1"
  allow hosts "staging.example.invalid"
  authorized target "https://staging.example.invalid" reason "acceptance fixture for the public-target gate; RFC 2606 guarantees this name never resolves, so nothing is ever reached"

# Cookie auth rather than bearer, deliberately: `sec/authenticated-response-cacheable`'s precondition
# is "the request carried session or bearer credentials", and a cookie session exercises the half
# that comes from tflw's own jar rather than from a header the test wrote.
#
# **M137b (D433) adds the `csrf from` clause, and it changes what this session can do.** apiV2 issues
# a CSRF token in the `session-login` body and its `AnyAuthGuard` demands the matching header on any
# mutating request; before this clause existed there was no way for a `session` block to supply it, so
# every mutating probe under this principal was refused before authorization was ever consulted
# (`M130-01`). One line now captures the token at establishment and attaches it to mutating requests
# only — `api` steps and probes alike. What used to be an engine limitation is a *configuration
# choice*, and `shopperNoCsrf` below is this corpus taking the other side of it.
session shopper
  api POST /auth/session-login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  csrf from body.csrfToken send as header "X-CSRF-Token"

# --- M130c: the principals Tier 2 probes with -------------------------------------------------
#
# Tier 2 re-issues the owner's request under every *other* declared session, so the probe set is a
# property of this file rather than of any test. For a `peer`-owned assertion here it is
# `{shopper, shopperBearer, shopperNoCsrf, anonymous}` — `admin` is excluded by the `privileged` line
# below, and `anonymous` is built in and always probed (D306). The root `tflw.config` also declares two
# `oauth2` sessions, so D319's measured cost differs between the two repos: the price is a property
# of the config, and quoting one repo's number for the other would be wrong. **Neither number is
# written down here** — `verify-security-acceptance.mjs` prints what it measured, so adding the
# session below moved the figure without anyone editing a constant (M132b).
#
# **`shopper` deliberately stays a cookie session** (`M130-01`), and after `M137b` it is a cookie
# session that can answer. The design it was keeping alive is unchanged and still worth stating: when a
# cookie-borne principal *cannot* meet a CSRF pre-flight, the right answer is to probe anyway and
# report the refusal as *inconclusive*, never to skip it — the app most worth catching is the one with
# cookie auth and no CSRF defence at all, and a pre-flight skip would decline to probe exactly that
# app. What changed is only which principal exercises that path: `shopperNoCsrf` does now, by
# declaration rather than by the engine's inability, and `shopper` demonstrates the other half.

# The other ordinary user — the identity the leaks leak *to*. Bearer, not cookie: as the probing
# principal on a `DELETE`, a cookie-borne `peer` would be refused for CSRF before authorization was
# ever consulted, and V8's plant would read as correctly-denied when it was never asked (D317's
# correction, made against the running app rather than on paper).
session peer
  api POST /auth/login body { email: env(USER_B_EMAIL), password: env(USER_B_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"

# **The same human as `shopper`, holding a bearer token instead of a cookie** (M132b, D356). Alice
# is declared twice on purpose, and the pair is the sharpest thing this config demonstrates: a probe
# outcome is a fact about the *credential*, not about the person. On a mutating request `shopper` is
# refused for a missing `X-CSRF-Token` and reported **inconclusive**, while `shopperBearer` — same
# user, same permissions, same lack of any claim on `peer`'s order — completes the request and can
# be judged. Nothing about the identity changed; only the way it authenticates did.
#
# **Without this session no mutating probe in this corpus could be judged at all, by anybody**, and
# that was a real gap rather than a stylistic one. The probe set for a `peer`-owned assertion was
# `{shopper, anonymous}`: cookie-borne, so inconclusive on any mutating verb, plus anonymous, which
# is `401`. Every principal was excluded for a correct reason and the exclusions composed until
# nobody was left to answer — the *zero judgeable principals* case, which the guide now states as a
# named limit (`authorization-testing.md`) and which this corpus was silently exhibiting.
#
# It also de-confounds `V8`. "The `DELETE` could not be judged" was equally consistent with *a
# replay cannot judge destruction* and with *nobody in the probe set could have answered anyway*;
# the two explanations predicted the same report. With a bearer non-owner present, `V8` and `V9`
# run under one probe set against one host and differ in exactly one variable — whether the verb
# destroys what it touches — and only `V9` yields a verdict. That is the controlled comparison
# `M130-05` wanted, and it is why this session belongs here rather than in a test.
session shopperBearer
  api POST /auth/login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"

# **Alice a third time — cookie transport, and no `csrf from` clause** (M137b, D455). The trio above
# and below it is the point: same human, same permissions, three credentials, and the probe outcome is
# a fact about the credential every time. `shopper` supplies the token and completes a mutating probe;
# `shopperBearer` needs no token and completes one; this one cannot supply the token and is refused
# before authorization is consulted, which the tier reports as **inconclusive** with the reason naming
# CSRF. Two transports and two configurations of one transport, and only the third is un-askable.
#
# **It is declared because `M137b` would otherwise have retired a control by fixing its cause.**
# `verify-security-acceptance.mjs`'s `NEVER_DECLINED` asserts that `shopperBearer` appears in no
# blind-spot decline, and it earned that place *by contrast* with `shopper` being declined for CSRF.
# Give `shopper` the clause and neither principal is ever declined: the assertion still passes and can
# no longer fail — a control whose positive cannot occur, which is the exact defect this corpus's own
# `V9` row was added to repair (`D356`). This session keeps the positive reachable, and keeps
# `M130-01`'s shape observable after the milestone that removes its cause.
#
# It carries no `capture`/`header` line for the same reason `shopper` carries none: the cookie arrives
# in tflw's own jar. The *only* difference between this session and `shopper` is the missing clause,
# which is what makes the pair evidence about the clause rather than about anything else.
session shopperNoCsrf
  api POST /auth/session-login body { email: env(USER_A_EMAIL), password: env(USER_A_PW) }
  expect status equals 200

# **`privileged`, and this is the whole reason the keyword exists.** An administrator legitimately
# reads other people's orders. Probe as one and every ownership-scoped route in the app returns the
# owner's resource to a non-owner, which is *true* and useless — a finding about the role model, not
# about a boundary. Excluded from every probe set, and announced on each assertion rather than
# quietly dropped, so a reader can see the probe set shrink and why.
#
# It is a claim about authority, not a speed knob: marking every session privileged empties the probe
# set of real identities and lands the assertion in D285's no-power-to-fail branch (`TF063`), which
# is the checker refusing to let a suite buy silence with a keyword.
session admin privileged
  api POST /auth/login body { email: env(ADMIN_EMAIL), password: env(ADMIN_PW) }
  expect status equals 200
  capture body.accessToken as token
  header "Authorization" is "Bearer {token}"

# --- M137f: the admin console's own session (tflw D442) ---------------------------------------
#
# **A fourth transport, and the first one that is not apiV2's.** The console authenticates the browser
# with a plain `express-session` cookie of its own (`admin.sid`) — it holds apiV2's bearer credentials
# server-side and never gives them to the client — so this session is established by submitting the
# console's own HTML login form and letting tflw's cookie jar keep what comes back. `form` rather than
# `body`, because that is what the form posts and a JSON body would be a request no browser makes.
#
# **It does NOT currently produce an authenticated walk, and that is a filed engine defect rather than
# a property of this declaration** — tflw `M137f-01`. Measured on the first live run: the crawl's
# *probes* carry the cookie, and the *walk's* own page fetches do not, so `GET /` is answered `302 →
# /login` and the spider enumerates only the logged-out surface. The session is kept here because it is
# correct and because the row is about when it is established, not whether it works; `spider.tflw`'s
# crawl is titled for what actually happens until that is fixed.
#
# **`POST /login` carries no `_csrf` field, and that is the app rather than an omission here.** Its
# router is the one route in the console that does not go through `verifyCsrf` — every other form does.
# So there is nothing for a `csrf from` clause to capture at establishment, and the console's token is
# per-session and re-read from each rendered page. That is exactly why the crawl below withholds
# `probe mutating`: a synthesized console write would be answered `403 Missing or invalid CSRF token`
# and read as a hardened endpoint, which is `M130-01`'s shape on a browser surface.
#
# Named service rather than an absolute URL, per `TF057`'s own advice; `allow hosts "localhost"` covers
# the host and the `authorized target` above is what permits it to be scanned at all.
session console
  api adminConsole POST /login form email=env(ADMIN_EMAIL), password=env(ADMIN_PW)
  expect status equals 200
