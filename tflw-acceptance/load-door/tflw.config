# `M224`'s own corpus — the LOAD door's Compose pane, with something to compose.
#
# **WHY THIS IS A SUB-PROJECT AND NOT A DIRECTORY UNDER `tests/`.** The dogfood suite carries 321
# tests and not one workload line, so the LOAD door opens on 86 dimmed file rows and nothing to
# select. The obvious fix — put workload tests in `tests/` — is the wrong one twice over: a bare
# `tflw run` would then carry them, and the run's bottleneck judgement is a property of the WHOLE
# run, so one saturating workload can mark every threshold in the suite `skipped` and flip the
# repository's headline verdict to INCONCLUSIVE. `examples/storefront/tests/load.tflw` in the tflw
# repository records that happening and the measurement behind it.
#
# So this lives under `tflw-acceptance/`, which the root config already excludes from discovery
# (`exclude "tflw-acceptance"`), and is opened as its own project:
#
#     node cli.mjs start                                  # the dogfood stack, api on :4001
#     npx tflw ui tflw-acceptance/load-door               # the page — open the LOAD door
#     cd tflw-acceptance/load-door && npx tflw run        # the whole corpus, ~20s
#
# There is no `--config` flag on `run` or `check`: a project IS the directory you run from, so the
# third line is a `cd` and not a switch. The README beside this file was wrong about that once.
#
# Nothing here needs a session: every endpoint it touches is a public read, so there is no `.env`
# to write and no `require env` to satisfy — unlike `tflw-acceptance/perf/tflw/`, whose rungs
# authenticate. That is deliberate. A corpus you have to configure before you can look at it is a
# corpus nobody looks at.
defaults
  timeout api 5s
  viewport 900 600

env local default
  # Named the same way the root config names them (`M197`, tflw `D1024`/`D1025`), so a stack
  # started under `TFLW_STACK_OFFSET` is reachable from here without editing this file.
  api env TFLW_API_BASE default "http://localhost:4001/v1"
  web env TFLW_WEB_BASE default "http://localhost:8090"
