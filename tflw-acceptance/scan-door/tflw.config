# `M228`'s own corpus — the SCANS door's Compose pane, with something to compose.
#
# **WHY THIS IS A SUB-PROJECT**, for the same reason `../load-door/` is: the dogfood suite's own
# scan assertions live in `tflw-acceptance/security/`, half of them `.checkonly` fixtures that
# exist to fire `TF060`, so opening the SCANS door on the repo root shows a wall of dimmed rows.
# `tflw-acceptance` is already excluded from root discovery, so this opens as its own project:
#
#     npx tflw ui tflw-acceptance/scan-door          # the page — open the SCANS door
#     cd tflw-acceptance/scan-door && npx tflw check # what the checker says about all of it
#
# **THE TARGET IS THE `tflw` REPO'S OWN STOREFRONT EXAMPLE**, on :4720, started by
# `npm run example:serve` over in `testFlow/`. It is chosen rather than this repo's apiV2 for a
# reason its own `examples/storefront/tests/scan.tflw` header states at length: the security family
# judges **the HTTP surface a browser trusts** — a cookie, `https`, a CORS header, a `text/html`
# document — and a JSON API on loopback presents none of it, so a scan pointed at one is vacuous
# by construction whatever the server does. The storefront hands out `cart=anon-1; HttpOnly;
# SameSite=Lax` on `GET /`, so `sec/cookie-not-httponly` **applies**, and then passes.
#
# Everything on this door except ▶ works with the target down.
defaults
  timeout api 5s

env local default
  api "http://127.0.0.1:4720"
  # The same host as a page, for the two tests here that also `open` one — `families.tflw`'s a11y
  # test and `mixed.tflw`'s last one, both of which exist to show where the SCANS door's vocabulary
  # ENDS.
  web "http://127.0.0.1:4720"

  # The affirmation, with two of the four opt-ins granted (`D291`, SPEC §3.10). The page will not
  # write this line for you and says so; it is here because this host is a local example server
  # this repository starts and stops.
  #
  # **The two opt-ins are what make `has no input-handling violations` do anything at all.** Without
  # them that matcher reports *not probed* rather than sending, which is a distinction the run
  # prints and nothing in the UI could say before `M228` `A`. The `scan` segment names them.
  authorized target "http://127.0.0.1:4720" reason "the tflw repo's storefront example, on loopback, started and stopped by whoever is reading this"
    probe oversized
    probe traversal

  # **A SECOND SCANNABLE ORIGIN, DELIBERATELY NOT AUTHORIZED.** `TF060` widened from the default
  # `api` base to every origin an env can reach (tflw `M131a`, `D343`), so this one line makes
  # every scan assertion in the corpus `TF060` until it is either authorized or removed — which is
  # the point: it is what puts the `scan` segment's coverage table into its interesting state, with
  # one row covered and one not, and what puts a real diagnostic in the pane's own Source preview.
  #
  # **UN-comment it and the whole corpus is refused.** That is the exercise, and it runs in the
  # direction that leaves the project runnable at rest: with this line commented, `run
  # selection` and ▶ work and the scan families actually report; with it live, `TF060` is
  # env-wide and refuses every scan assertion in all four files before a socket is opened.
  #
  # The `scan` segment reads the DEFAULT env either way — `ui-server.ts` calls `readProject`
  # with no env — so this cannot be parked in a second env and reached with the run strip's
  # picker. That is `M228` `F`.
  # api orders "http://127.0.0.1:4002/v1"
