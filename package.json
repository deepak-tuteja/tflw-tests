{
  "name": "testflow-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Purpose-built realistic e-commerce API (NestJS+Postgres, Dockerized) for tflw (testFlow) \u2014 its dogfood/acceptance target and DSL gap-discovery instrument.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepak-tuteja/tflw-tests.git"
  },
  "license": "MIT",
  "author": "Deepak Tuteja <33311251+deepak-tuteja@users.noreply.github.com>",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "refresh-tflw": "node scripts/refresh-tflw.mjs",
    "test": "tflw run",
    "test:mtls": "tflw run --env mtlsSidecar tests/api/identity/mtls.tflw",
    "test:mtls-rejection": "tflw run --env mtlsSidecarNoCert tests/.env-specific/mtls-rejection.tflw",
    "test:safety": "tflw run --env safetyRedaction tests/api/identity/safety-redaction.tflw",
    "test:logging": "tflw run --env logConfig tests/api/mechanics/logging.tflw",
    "test:unreachable-host": "tflw run --env unreachableHost tests/.env-specific/unreachable-host.tflw",
    "test:secure-local": "tflw run --env secureLocal tests/.env-specific/secure-local.tflw",
    "verify:security-target": "node scripts/verify-security-target.mjs",
    "verify:vuln-slice-hidden": "node scripts/verify-vuln-slice-hidden.mjs",
    "verify:security-acceptance": "node scripts/verify-security-acceptance.mjs",
    "verify:security-acceptance:gate": "node scripts/verify-security-acceptance.mjs --gate",
    "verify:input-acceptance": "node scripts/verify-input-acceptance.mjs",
    "verify:sarif-acceptance": "node scripts/verify-sarif-acceptance.mjs",
    "verify:artifact-contract": "node scripts/verify-artifact-contract.mjs",
    "sweep:input-volume": "node scripts/sweep-input-volume.mjs",
    "test:webv2-admin": "tflw run --env webv2Admin tests/.env-specific/webv2-admin.tflw tests/.env-specific/orgs-mixed.tflw",
    "test:ui-admin": "tflw run --env webv2Admin tests/.env-specific/ui-admin/*.tflw",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "regression": "node scripts/regression.mjs",
    "regression:smoke": "node scripts/regression-smoke.mjs",
    "verify:external-targets": "node scripts/verify-external-targets.mjs",
    "verify:perf-parity": "node scripts/verify-perf-parity.mjs",
    "verify:perf-baseline": "node scripts/verify-perf-baseline.mjs",
    "perf:conformance": "node scripts/perf-conformance.mjs",
    "verify:contributing": "node scripts/verify-contributing.mjs",
  "verify:scrub": "node scripts/verify-scrub.mjs",
    "verify:sweep-size": "node scripts/verify-sweep-size.mjs",
    "verify:argv-contract": "node scripts/verify-argv-contract.mjs",
    "verify:tflw-resolution": "node scripts/verify-tflw-resolution.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "verify:provenance:self-test": "node scripts/verify-provenance.mjs --self-test",
    "verify:notation-parity": "node scripts/verify-notation-parity.mjs",
    "verify:notation-parity:self-test": "node scripts/verify-notation-parity.mjs --self-test",
    "refresh:own-identifiers": "node scripts/refresh-own-identifiers.mjs",
    "verify:own-identifiers": "node scripts/refresh-own-identifiers.mjs --check",
    "verify:construct-coverage": "node scripts/verify-construct-coverage.mjs",
    "refresh:check-coverage": "node scripts/verify-check-diagnostics.mjs --write",
    "verify:redaction:self-test": "node scripts/verify-redaction.mjs --self-test",
    "verify:construct-acceptance": "node scripts/verify-construct-acceptance.mjs",
    "verify:construct-acceptance:gate": "node scripts/verify-construct-acceptance.mjs --gate",
    "list:mutation-candidates": "node scripts/list-mutation-candidates.mjs",
    "discover:mutation-kills": "node scripts/discover-mutation-kills.mjs",
    "read:mutation-matrix": "node scripts/read-mutation-matrix.mjs",
    "read:mutation-matrix:gate": "node scripts/read-mutation-matrix.mjs --gate"
  },
  "dependencies": {
    "tflw": "file:vendor/tflw-0.1.0.tgz"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "playwright": "^1.62.0"
  }
}
